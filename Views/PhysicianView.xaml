<UserControl x:Class="OPDClinic.Views.PhysicianView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OPDClinic">

    <Grid Background="{StaticResource ContentBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" Padding="24,16"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Text="{DynamicResource Physician.Title}"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding PhysicianCount, StringFormat='{}{0} physician(s)'}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" VerticalAlignment="Center"
                               Margin="0,0,16,0"/>
                    <Button Content="{DynamicResource Common.Export}"
                            Style="{StaticResource SecondaryButton}"
                            Click="ExportPhysicians_Click"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"/>
                    <Button Content="{DynamicResource Physician.Btn.Add}"
                            Style="{StaticResource PrimaryButton}"
                            Click="AddPhysician_Click"
                            VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Physician cards + empty state -->
        <Grid Grid.Row="1">
        <ScrollViewer Padding="24,20">
            <ItemsControl ItemsSource="{Binding Physicians}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Avatar: symbol image if uploaded, else initials circle -->
                                <Grid Grid.Column="0" Width="56" Height="56" VerticalAlignment="Top">
                                    <!-- Initials circle (shown when no image) -->
                                    <Border Width="52" Height="52"
                                            Background="{StaticResource PrimaryBrush}"
                                            CornerRadius="26"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding SymbolImage,
                                                         Converter={x:Static local:Converters.ByteArrayToInvisibility}}">
                                        <TextBlock Text="{Binding NameEng, Converter={x:Static local:Converters.NameToInitials}}"
                                                   FontSize="16" FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <!-- Symbol image (shown when SymbolImage has data) -->
                                    <Image Source="{Binding SymbolImage,
                                                    Converter={x:Static local:Converters.ByteArrayToImage}}"
                                           Visibility="{Binding SymbolImage,
                                                        Converter={x:Static local:Converters.ByteArrayToVisibility}}"
                                           Stretch="Uniform"
                                           Width="56" Height="56"/>
                                </Grid>

                                <!-- Physician details -->
                                <StackPanel Grid.Column="1" Margin="16,0,16,0">
                                    <TextBlock Text="{Binding NameEng}"
                                               FontSize="15" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding NameDari}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FlowDirection="RightToLeft"
                                               HorizontalAlignment="Left"
                                               Margin="0,2,0,6"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="🏥 " FontSize="11"/>
                                        <TextBlock Text="{Binding SpecialityEng}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding SpecialityDari}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FlowDirection="RightToLeft"
                                               HorizontalAlignment="Left"
                                               Margin="0,0,0,6"/>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="☎  " FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding ContactNumber}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,0,20,0"/>
                                        <TextBlock Text="📱  " FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding WhatsAppNumber}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Address}"
                                               FontSize="10" Margin="0,4,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Action buttons -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Top"
                                            Orientation="Horizontal">
                                    <Button Content="{DynamicResource Common.Edit}"
                                            Style="{StaticResource ActionButton}"
                                            Padding="12,6" FontSize="12"
                                            Tag="{Binding}"
                                            Click="EditPhysician_Click"
                                            Margin="0,0,8,0"/>
                                    <Button Content="{DynamicResource Common.Delete}"
                                            Style="{StaticResource ActionButton}"
                                            Foreground="{StaticResource DangerBrush}"
                                            Padding="12,6" FontSize="12"
                                            Command="{Binding DataContext.DeletePhysicianCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty state — shown when no physicians are registered -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding PhysicianCount, Converter={x:Static local:Converters.ZeroToVisible}}">
            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="52"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource BorderBrush}"/>
            <TextBlock Text="No physicians registered"
                       FontSize="15" FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,12,0,4"/>
            <TextBlock Text="Click '+ Add Physician' to register the first physician."
                       FontSize="12" HorizontalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>
        </Grid>

    </Grid>
</UserControl>
