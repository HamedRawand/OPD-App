<Window x:Class="OPDClinic.Views.UpdateAvailableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OPDClinic"
        Title="{DynamicResource Update.Title}"
        Height="520" Width="560"
        MinHeight="440" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource ContentBgBrush}"
        FlowDirection="{DynamicResource App.FlowDirection}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- header    -->
            <RowDefinition Height="Auto"/>  <!-- versions  -->
            <RowDefinition Height="*"/>     <!-- notes     -->
            <RowDefinition Height="Auto"/>  <!-- progress  -->
            <RowDefinition Height="Auto"/>  <!-- buttons   -->
        </Grid.RowDefinitions>

        <!-- ── Header ───────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="24,18">
            <StackPanel>
                <TextBlock Text="{DynamicResource Update.Available}"
                           Foreground="White" FontSize="17" FontWeight="Bold"/>
                <TextBlock x:Name="SubtitleText"
                           Foreground="#BBDEFB" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── Version comparison ────────────────────────────────────────── -->
        <Border Grid.Row="1" Background="White" Padding="24,16"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Current -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="{DynamicResource Update.CurrentVersion}"
                               FontSize="11" Foreground="#777" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="CurrentVersionText"
                               FontSize="20" FontWeight="Bold"
                               Foreground="#444" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Arrow -->
                <TextBlock Grid.Column="1" Text="→"
                           FontSize="22" Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- New -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="{DynamicResource Update.NewVersion}"
                               FontSize="11" Foreground="#777" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="NewVersionText"
                               FontSize="20" FontWeight="Bold"
                               Foreground="#16A34A" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Release notes ─────────────────────────────────────────────── -->
        <Border Grid.Row="2" Margin="16,12,16,0">
            <Border Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="#F1F5F9"
                            Padding="12,8" CornerRadius="5,5,0,0">
                        <TextBlock Text="{DynamicResource Update.ReleaseNotes}"
                                   FontWeight="SemiBold" FontSize="12"
                                   Foreground="#6B7280"/>
                    </Border>
                    <ScrollViewer Padding="12,10" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="ReleaseNotesText"
                                   TextWrapping="Wrap" FontSize="12.5"
                                   LineHeight="20" FlowDirection="LeftToRight"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>

        <!-- ── Progress ──────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="3" Margin="16,10,16,0"
                    x:Name="ProgressPanel" Visibility="Collapsed">
            <TextBlock x:Name="ProgressText"
                       Text="{DynamicResource Update.Downloading}"
                       FontSize="12" Foreground="#444" Margin="0,0,0,6"/>
            <ProgressBar x:Name="DownloadProgress"
                         Height="8" Minimum="0" Maximum="100"
                         Foreground="{StaticResource PrimaryBrush}"
                         Background="#E0E0E0"/>
        </StackPanel>

        <!-- ── Error message ─────────────────────────────────────────────── -->
        <Border Grid.Row="3" x:Name="ErrorBorder"
                Background="#FEE2E2" CornerRadius="5" Padding="10,6"
                Margin="16,10,16,0" Visibility="Collapsed">
            <TextBlock x:Name="ErrorText"
                       Foreground="#B91C1C" FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <!-- ── Buttons ───────────────────────────────────────────────────── -->
        <Border Grid.Row="4" Background="White" Padding="16,12"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Margin="0,10,0,0">
            <DockPanel LastChildFill="False">
                <Button x:Name="UpdateBtn"
                        DockPanel.Dock="Right"
                        Content="{DynamicResource Update.BtnInstall}"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        MinWidth="140" Click="UpdateNow_Click"/>
                <Button DockPanel.Dock="Right"
                        Content="{DynamicResource Update.BtnLater}"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="100" Margin="0,0,10,0"
                        Click="Later_Click" IsCancel="True"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
