<Window x:Class="OPDClinic.Views.PatientDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OPDClinic"
        Title="{Binding PatientHeader}"
        Height="680" Width="860"
        MinHeight="500" MinWidth="660"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource ContentBgBrush}"
        FlowDirection="{DynamicResource App.FlowDirection}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisible"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Summary stats bar -->
            <RowDefinition Height="Auto"/>  <!-- Vitals chart panel (collapsible) -->
            <RowDefinition Height="*"/>     <!-- Visit timeline -->
        </Grid.RowDefinitions>

        <!-- ── Row 0: Header bar ─────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="24,16">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Vertical">
                    <TextBlock Text="{Binding Patient.PatientName}"
                               Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Patient.PatientCode}"
                                   Foreground="#B3E5FC" FontSize="13" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding Patient.Sex}"
                                   Foreground="#B3E5FC" FontSize="13" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding Patient.PhoneNumber}"
                                   Foreground="#B3E5FC" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{DynamicResource Common.Export}"
                            Style="{StaticResource SecondaryButton}"
                            Background="White" Foreground="{StaticResource PrimaryBrush}"
                            Click="ExportVisits_Click"
                            Margin="0,0,8,0"/>
                    <Button Content="{DynamicResource PatDetail.NewVisit}"
                            Style="{StaticResource SecondaryButton}"
                            Background="White" Foreground="{StaticResource PrimaryBrush}"
                            ToolTip="New visit  (Ctrl+N)"
                            Click="NewVisit_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Row 1: Summary stats bar ─────────────────────────────────────── -->
        <Border Grid.Row="1" Background="#EEF2F7" Padding="24,8"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <!-- Vitals Trend toggle — only shown when chart data exists -->
                <Button x:Name="ChartToggleBtn"
                        DockPanel.Dock="Right"
                        Content="▾ Vitals Trend"
                        Style="{StaticResource ActionButton}"
                        Click="ChartToggle_Click"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasVitalsChart, Converter={StaticResource BoolToVisible}}"/>
                <!-- Visit count + date summary -->
                <TextBlock Text="{Binding SummaryText}"
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ── Row 2: Vitals Trend chart panel (collapsed by default) ────────── -->
        <Border x:Name="ChartPanel" Grid.Row="2"
                Background="#FAFBFC"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Visibility="Collapsed">
            <Grid Margin="24,12,24,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="130"/>  <!-- Chart canvas -->
                    <RowDefinition Height="Auto"/> <!-- Legend -->
                </Grid.RowDefinitions>

                <!-- Canvas — drawn in code-behind -->
                <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="4" Background="White">
                    <Canvas x:Name="VitalsCanvas"
                            SizeChanged="VitalsCanvas_SizeChanged"
                            ClipToBounds="True"/>
                </Border>

                <!-- Legend -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Ellipse Width="10" Height="10" Margin="0,0,5,0" VerticalAlignment="Center">
                        <Ellipse.Fill><SolidColorBrush Color="#1565C0"/></Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="Body Weight (kg)" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,18,0"/>
                    <Ellipse Width="10" Height="10" Margin="0,0,5,0" VerticalAlignment="Center">
                        <Ellipse.Fill><SolidColorBrush Color="#C62828"/></Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="Systolic BP (mmHg)" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Row 3: Visit timeline ─────────────────────────────────────────── -->
        <Grid Grid.Row="3">

            <!-- Timeline card list -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Padding="16,12,16,16" FlowDirection="LeftToRight">
                <ItemsControl ItemsSource="{Binding Visits}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <!-- Outer row: timeline gutter (dot+line) + card -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- ── Timeline connector ── -->
                                <Grid Grid.Column="0">
                                    <!-- Vertical connecting line -->
                                    <Rectangle Width="2" HorizontalAlignment="Center"
                                               VerticalAlignment="Stretch">
                                        <Rectangle.Fill>
                                            <SolidColorBrush Color="#1565C0" Opacity="0.25"/>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <!-- Circle dot (sits on top of the line) -->
                                    <Ellipse Width="12" Height="12"
                                             HorizontalAlignment="Center" VerticalAlignment="Top"
                                             Margin="0,16,0,0"
                                             Stroke="White" StrokeThickness="2">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="#1565C0"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>

                                <!-- ── Visit card ── -->
                                <Border Grid.Column="1"
                                        CornerRadius="8"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        Background="White">
                                    <StackPanel Margin="14,12,12,12">

                                        <!-- ── Header: date / physician  +  action buttons ── -->
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Top">
                                                <Button Content="{DynamicResource Common.Edit}"
                                                        Style="{DynamicResource ActionButton}"
                                                        Tag="{Binding}" Click="EditVisit_Click"
                                                        Margin="0,0,4,0"/>
                                                <Button Content="{DynamicResource Common.Print}"
                                                        Style="{DynamicResource ActionButton}"
                                                        Tag="{Binding}" Click="PrintVisit_Click"
                                                        Margin="0,0,4,0"/>
                                                <Button Content="{DynamicResource Common.Repeat}"
                                                        Style="{DynamicResource ActionButton}"
                                                        ToolTip="Open a new visit pre-filled with this prescription"
                                                        Tag="{Binding}" Click="RepeatVisit_Click"
                                                        Margin="0,0,4,0"/>
                                                <Button Content="{DynamicResource Common.Delete}"
                                                        Style="{DynamicResource DangerButton}"
                                                        Tag="{Binding}" Click="DeleteVisit_Click"/>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DateText}"
                                                               FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="  ·  "
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding ShamsiText}"
                                                               FontSize="13"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding PhysicianName}"
                                                           FontSize="12" Margin="0,2,0,0"
                                                           Foreground="{StaticResource PrimaryBrush}"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- ── Diagnosis ── -->
                                        <TextBlock Text="{Binding Diagnosis}"
                                                   FontSize="13" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Margin="0,8,0,0"/>

                                        <!-- ── Stats chips  +  ▾ Details toggle ── -->
                                        <DockPanel Margin="0,8,0,0">
                                            <Button DockPanel.Dock="Right"
                                                    Tag="{Binding}" Click="ToggleDetails_Click"
                                                    VerticalAlignment="Center">
                                                <Button.Style>
                                                    <Style TargetType="Button"
                                                           BasedOn="{StaticResource ActionButton}">
                                                        <Setter Property="Content" Value="▾ Details"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}"
                                                                         Value="True">
                                                                <Setter Property="Content" Value="▴ Hide"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <WrapPanel VerticalAlignment="Center">
                                                <!-- Age chip -->
                                                <Border CornerRadius="4" Background="#EEF2F7"
                                                        Padding="7,3" Margin="0,0,6,0"
                                                        Visibility="{Binding Age, Converter={x:Static local:Converters.NullToCollapsed}}">
                                                    <TextBlock FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Text="{Binding Age, StringFormat='Age: {0}'}"/>
                                                </Border>
                                                <!-- Rx chip -->
                                                <Border CornerRadius="4" Background="#EEF2F7"
                                                        Padding="7,3" Margin="0,0,6,0">
                                                    <TextBlock FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Text="{Binding RxCount, StringFormat='💊 {0} med(s)'}"/>
                                                </Border>
                                                <!-- Lab chip — hidden when zero -->
                                                <Border CornerRadius="4" Background="#EEF2F7"
                                                        Padding="7,3">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LabCount}"
                                                                             Value="0">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Text="{Binding LabCount, StringFormat='🧪 {0} lab(s)'}"/>
                                                </Border>
                                            </WrapPanel>
                                        </DockPanel>

                                        <!-- ── Expanded detail panel ── -->
                                        <Border Visibility="{Binding IsExpanded,
                                                             Converter={StaticResource BoolToVisible}}"
                                                Background="#F8FAFC" CornerRadius="6"
                                                Padding="12,10" Margin="0,10,0,2"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1">
                                            <StackPanel>

                                                <!-- Vitals -->
                                                <TextBlock Text="{Binding VitalsSummary}"
                                                           FontSize="12" FontFamily="Consolas"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FlowDirection="LeftToRight"
                                                           Visibility="{Binding HasVitals,
                                                                        Converter={StaticResource BoolToVisible}}"/>

                                                <!-- Clinical findings -->
                                                <TextBlock Text="{Binding ClinicalFindings}"
                                                           FontSize="12" TextWrapping="Wrap"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           Margin="0,6,0,0"
                                                           Visibility="{Binding ClinicalFindings,
                                                                        Converter={x:Static local:Converters.NullToCollapsed}}"/>

                                                <!-- Prescription lines -->
                                                <ItemsControl ItemsSource="{Binding RxLineSummaries}"
                                                              Margin="0,6,0,0"
                                                              FlowDirection="LeftToRight">
                                                    <ItemsControl.Style>
                                                        <Style TargetType="ItemsControl">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasRx}"
                                                                             Value="False">
                                                                    <Setter Property="Visibility"
                                                                            Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ItemsControl.Style>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}"
                                                                       FontSize="12"
                                                                       FontFamily="Consolas"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       Margin="0,2,0,0"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Lab tests summary -->
                                                <TextBlock Text="{Binding LabTestsSummary}"
                                                           FontSize="12" TextWrapping="Wrap"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,6,0,0"
                                                           Visibility="{Binding HasLabs,
                                                                        Converter={StaticResource BoolToVisible}}"/>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </Border>

                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding Visits.Count, Mode=OneWay,
                                     Converter={x:Static local:Converters.ZeroToVisible}}">
                <Viewbox Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Fill="{StaticResource BorderBrush}" Data="{StaticResource Ico.Person}"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="No visits recorded"
                           FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,10,0,4"/>
                <TextBlock Text="Click '+ New Visit' to record the first encounter."
                           FontSize="12" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,16"/>
                <Button Content="🗑  Delete Patient Record"
                        Style="{DynamicResource DangerButton}"
                        HorizontalAlignment="Center"
                        Padding="16,8"
                        Click="DeletePatient_Click"/>
            </StackPanel>

        </Grid>
    </Grid>
</Window>
