<Window x:Class="OPDClinic.Views.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Password / تغییر رمز عبور"
        Width="400" Height="400" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource ContentBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Scrollable form content -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="32,28,32,12">
            <StackPanel>

                <TextBlock Text="Change Your Password" FontSize="17" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <TextBlock Text="You must set a new password before continuing."
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,24"/>

                <TextBlock Text="Current Password" Style="{StaticResource FormLabel}"/>
                <PasswordBox x:Name="CurrentPwdBox"
                             Padding="10,8" FontSize="13" Margin="0,4,0,14"
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>

                <TextBlock Text="New Password" Style="{StaticResource FormLabel}"/>
                <PasswordBox x:Name="NewPwdBox"
                             Padding="10,8" FontSize="13" Margin="0,4,0,14"
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>

                <TextBlock Text="Confirm New Password" Style="{StaticResource FormLabel}"/>
                <PasswordBox x:Name="ConfirmPwdBox"
                             Padding="10,8" FontSize="13" Margin="0,4,0,8"
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}"
                           FontSize="12" Visibility="Collapsed" Margin="0,0,0,4"
                           TextWrapping="Wrap"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Sticky footer with buttons — always visible -->
        <Border Grid.Row="1" Background="White" Padding="32,14,32,20"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save &amp; Continue"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        Padding="20,8" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
