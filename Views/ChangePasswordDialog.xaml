<Window x:Class="OPDClinic.Views.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Password / تغییر رمز عبور"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource ContentBgBrush}">

    <StackPanel Margin="32,28">

        <TextBlock Text="Change Your Password" FontSize="17" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
        <TextBlock Text="You must set a new password before continuing."
                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,24"/>

        <TextBlock Text="Current Password" Style="{StaticResource FormLabel}"/>
        <PasswordBox x:Name="CurrentPwdBox"
                     Padding="10,8" FontSize="13" Margin="0,4,0,14"
                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>

        <TextBlock Text="New Password" Style="{StaticResource FormLabel}"/>
        <PasswordBox x:Name="NewPwdBox"
                     Padding="10,8" FontSize="13" Margin="0,4,0,14"
                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>

        <TextBlock Text="Confirm New Password" Style="{StaticResource FormLabel}"/>
        <PasswordBox x:Name="ConfirmPwdBox"
                     Padding="10,8" FontSize="13" Margin="0,4,0,14"
                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}"
                   FontSize="12" Visibility="Collapsed" Margin="0,0,0,12"
                   TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save &amp; Continue"
                    Style="{StaticResource PrimaryButton}"
                    Padding="20,8" Click="Save_Click"/>
        </StackPanel>

    </StackPanel>
</Window>
