<UserControl x:Class="OPDClinic.Views.ImportWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource ContentBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" Padding="24,16"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{DynamicResource Import.Title}" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" Padding="40,28">
            <StackPanel MaxWidth="620" HorizontalAlignment="Left">

                <!-- Info card -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,24" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="About this import" FontWeight="SemiBold"
                                   FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   LineHeight="20">
                            This wizard imports data from the original Microsoft Access database
                            (.accdb) into the local SQLite database used by this application.
                            It imports physicians, medicines, lab tests, patients, and prescriptions.
                            Tables that already contain data are skipped automatically.
                        </TextBlock>
                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12"
                                   Foreground="#744210" Background="#FEFCBF"
                                   Padding="10,8">
                            Requires Microsoft Access Database Engine (ACE OLEDB 12.0) to be
                            installed on this machine. Download it from microsoft.com if needed.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- File picker -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,24" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="Select Access Database File"
                                   FontWeight="SemiBold" FontSize="14"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,12"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{DynamicResource Import.Btn.Browse}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="16,8" Margin="10,0,0,0"
                                    Click="Browse_Click"/>
                            <TextBox x:Name="FilePathBox"
                                     Style="{StaticResource FormTextBox}"
                                     IsReadOnly="True"
                                     Tag="No file selected…"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Import button -->
                <Button x:Name="ImportBtn" Content="{DynamicResource Import.Btn.Start}"
                        Style="{StaticResource PrimaryButton}"
                        Padding="32,10" FontSize="14"
                        HorizontalAlignment="Left"
                        IsEnabled="False"
                        Click="Import_Click"
                        Margin="0,0,0,24"/>

                <!-- Progress / results -->
                <Border x:Name="ResultCard" Style="{StaticResource Card}"
                        Padding="20,16" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ResultTitle" FontWeight="SemiBold"
                                   FontSize="14" Margin="0,0,0,12"/>

                        <Grid x:Name="CountGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Physicians" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                            <TextBlock x:Name="PhysiciansCount" Grid.Row="0" Grid.Column="1"
                                       FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Lab Tests" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                            <TextBlock x:Name="LabTestsCount" Grid.Row="1" Grid.Column="1"
                                       FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Medicines" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                            <TextBlock x:Name="MedicinesCount" Grid.Row="2" Grid.Column="1"
                                       FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Patients" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                            <TextBlock x:Name="PatientsCount" Grid.Row="3" Grid.Column="1"
                                       FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Prescriptions" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                            <TextBlock x:Name="PrescriptionsCount" Grid.Row="4" Grid.Column="1"
                                       FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2"/>
                        </Grid>

                        <TextBlock x:Name="ErrorDetail" Foreground="{StaticResource DangerBrush}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
