<Window x:Class="OPDClinic.Views.PrescriptionTemplatePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OPDClinic"
        Title="{DynamicResource RxTemplate.Picker.Title}"
        Height="480" Width="480"
        MinHeight="360" MinWidth="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FlowDirection="{DynamicResource App.FlowDirection}"
        Background="{StaticResource ContentBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="24,14">
            <TextBlock Text="{DynamicResource RxTemplate.Picker.Title}"
                       Foreground="White" FontSize="16" FontWeight="Bold"/>
        </Border>

        <!-- Search -->
        <StackPanel Grid.Row="1" Margin="24,16,24,8">
            <TextBox x:Name="SearchBox"
                     Style="{StaticResource FormTextBox}"
                     TextChanged="SearchBox_TextChanged"/>
            <TextBlock Text="{DynamicResource RxTemplate.Picker.SearchHint}"
                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="2,4,0,0"/>
        </StackPanel>

        <!-- Results -->
        <Grid Grid.Row="2" Margin="24,4,24,8">
            <ListBox x:Name="ResultsList"
                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                     MouseDoubleClick="ResultsList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="6,4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{Binding Description}" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding Description,
                                                    Converter={x:Static local:Converters.NullToCollapsed}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="{DynamicResource RxTemplate.Picker.NoResults}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding Items.Count, ElementName=ResultsList,
                                    Converter={x:Static local:Converters.ZeroToVisible}}"/>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Background="White" Padding="24,14"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="{DynamicResource RxTemplate.Picker.Select}"
                        Style="{StaticResource PrimaryButton}"
                        Click="Select_Click" MinWidth="120"/>
                <Button DockPanel.Dock="Right"
                        Content="{DynamicResource Common.Cancel}"
                        Style="{StaticResource SecondaryButton}"
                        IsCancel="True"
                        Click="Cancel_Click"
                        Margin="0,0,10,0" MinWidth="100"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
