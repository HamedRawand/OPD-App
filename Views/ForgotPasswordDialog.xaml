<Window x:Class="OPDClinic.Views.ForgotPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Forgot Password"
        Width="420" Height="380" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="LeftToRight"
        Background="{StaticResource ContentBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Scrollable form content -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="36,28,36,12">
            <StackPanel>

                <!-- Icon + title -->
                <TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" FontSize="40"
                           HorizontalAlignment="Center" Margin="0,0,0,10"
                           Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock Text="Reset Password"
                           FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,8"/>
                <TextBlock TextWrapping="Wrap" FontSize="12" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,24" TextAlignment="Center">
                    Enter your username and registered email address.
                    A temporary password will be sent to that email.
                </TextBlock>

                <!-- Username input -->
                <TextBlock Text="Username" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="UsernameBox"
                         Style="{StaticResource FormTextBox}"
                         Margin="0,4,0,14"
                         FlowDirection="LeftToRight"/>

                <!-- Email input -->
                <TextBlock Text="Registered Email Address" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="EmailBox"
                         Style="{StaticResource FormTextBox}"
                         Margin="0,4,0,16"
                         FlowDirection="LeftToRight"/>

                <!-- Status message -->
                <Border x:Name="StatusBorder" CornerRadius="6" Padding="12,10"
                        Margin="0,0,0,4" Visibility="Collapsed">
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Sticky footer with buttons — always visible -->
        <Border Grid.Row="1" Background="White" Padding="36,14,36,20"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        IsCancel="True" Padding="20,8" Margin="0,0,10,0"/>
                <Button x:Name="ResetBtn"
                        Content="Send Reset Email"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        Padding="20,8" Click="Reset_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
