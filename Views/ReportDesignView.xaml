<UserControl x:Class="OPDClinic.Views.ReportDesignView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OPDClinic"
             xmlns:vm="clr-namespace:OPDClinic.ViewModels"
             FlowDirection="LeftToRight">

    <UserControl.Resources>
        <!-- ── Converters ─────────────────────────────────────────────── -->
        <local:HexToBrushConverter          x:Key="HexToBrush"/>
        <local:BoolToFontWeightConverter    x:Key="BoolToFontWeight"/>
        <BooleanToVisibilityConverter       x:Key="BoolToVisible"/>

        <!-- ── Shared styles ──────────────────────────────────────────── -->
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Width"              Value="115"/>
            <Setter Property="VerticalAlignment"  Value="Center"/>
            <Setter Property="FontSize"           Value="11"/>
            <Setter Property="Foreground"         Value="{StaticResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize"       Value="10"/>
            <Setter Property="FontWeight"     Value="SemiBold"/>
            <Setter Property="Foreground"     Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin"         Value="0,10,0,4"/>
            <Setter Property="Padding"        Value="0,0,0,2"/>
        </Style>

        <Style x:Key="ColorRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <!-- ── Color swatch button (22×22 clickable colored square) ──── -->
        <Style x:Key="ColorSwatchButton" TargetType="Button">
            <Setter Property="Width"   Value="22"/>
            <Setter Property="Height"  Value="22"/>
            <Setter Property="Margin"  Value="3,0,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor"  Value="Hand"/>
            <Setter Property="ToolTip" Value="Click to choose a color"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Background="{TemplateBinding Background}" CornerRadius="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"     Value="#555555"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Alignment toggle button (RadioButton styled as a chip) ── -->
        <Style x:Key="AlignToggleButton" TargetType="RadioButton">
            <Setter Property="Height"                  Value="26"/>
            <Setter Property="Padding"                 Value="10,0"/>
            <Setter Property="FontSize"                Value="11"/>
            <Setter Property="Cursor"                  Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Background="White" Padding="{TemplateBinding Padding}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"   Value="#1565C0"/>
                                <Setter TargetName="Bd" Property="BorderBrush"  Value="#1565C0"/>
                                <Setter Property="Foreground"                   Value="White"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked"   Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background"  Value="#E8F0FE"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1565C0"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked"   Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background"  Value="#0D47A1"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0D47A1"/>
                                <Setter Property="Foreground"                  Value="White"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── DataTemplate for SectionStyleVm ───────────────────────── -->
        <DataTemplate x:Key="SectionTemplate" DataType="{x:Type vm:SectionStyleVm}">
            <StackPanel Margin="4,4,4,8">

                <!-- TYPOGRAPHY ─────────────────────────────────────── -->
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,10,0,4">
                    <TextBlock Text="TYPOGRAPHY" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Padding="0,0,0,2"/>
                </Border>

                <!-- Font Family -->
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Font Family" Style="{StaticResource SettingLabel}"/>
                    <ComboBox  Grid.Column="1" SelectedItem="{Binding FontFamily, Mode=TwoWay}"
                               ItemsSource="{x:Static vm:SectionStyleVm.AvailableFonts}"
                               Height="26" FontSize="11"/>
                </Grid>

                <!-- Font Size -->
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Font Size (pt)" Style="{StaticResource SettingLabel}"/>
                    <ComboBox  Grid.Column="1" SelectedItem="{Binding FontSize, Mode=TwoWay}"
                               ItemsSource="{x:Static vm:SectionStyleVm.CommonSizes}"
                               IsEditable="True" Height="26" FontSize="11"/>
                </Grid>

                <!-- Bold -->
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Bold" Style="{StaticResource SettingLabel}"/>
                    <CheckBox  Grid.Column="1" IsChecked="{Binding Bold, Mode=TwoWay}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Italic -->
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Italic" Style="{StaticResource SettingLabel}"/>
                    <CheckBox  Grid.Column="1" IsChecked="{Binding Italic, Mode=TwoWay}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Alignment -->
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Alignment" Style="{StaticResource SettingLabel}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <RadioButton Content="⬅ Left"
                                     IsChecked="{Binding IsAlignLeft, Mode=TwoWay}"
                                     GroupName="{Binding AlignGroupName}"
                                     Style="{StaticResource AlignToggleButton}"/>
                        <RadioButton Content="↔ Center"
                                     IsChecked="{Binding IsAlignCenter, Mode=TwoWay}"
                                     GroupName="{Binding AlignGroupName}"
                                     Style="{StaticResource AlignToggleButton}" Margin="4,0,0,0"/>
                        <RadioButton Content="➡ Right"
                                     IsChecked="{Binding IsAlignRight, Mode=TwoWay}"
                                     GroupName="{Binding AlignGroupName}"
                                     Style="{StaticResource AlignToggleButton}" Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Font Color -->
                <Grid Style="{StaticResource ColorRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="26"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Font Color" Style="{StaticResource SettingLabel}"/>
                    <TextBox   Grid.Column="1" Text="{Binding FontColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                               Height="26" FontSize="11" Padding="6,0"
                               VerticalContentAlignment="Center"/>
                    <Button    Grid.Column="2" Style="{StaticResource ColorSwatchButton}"
                               Background="{Binding FontColor, Converter={StaticResource HexToBrush}}"
                               Tag="FontColor" Click="ColorSwatch_Click"/>
                </Grid>

                <!-- APPEARANCE ─────────────────────────────────────── -->
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,10,0,4">
                    <TextBlock Text="APPEARANCE" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Padding="0,0,0,2"/>
                </Border>

                <!-- Background Color -->
                <Grid Style="{StaticResource ColorRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="26"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Background" Style="{StaticResource SettingLabel}"/>
                    <TextBox   Grid.Column="1" Text="{Binding BackgroundColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                               Height="26" FontSize="11" Padding="6,0"
                               VerticalContentAlignment="Center"/>
                    <Button    Grid.Column="2" Style="{StaticResource ColorSwatchButton}"
                               Background="{Binding BackgroundColor, Converter={StaticResource HexToBrush}}"
                               Tag="BackgroundColor" Click="ColorSwatch_Click"/>
                </Grid>

                <!-- Padding -->
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Padding (pt)" Style="{StaticResource SettingLabel}"/>
                    <TextBox   Grid.Column="1" Text="{Binding Padding, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                               Height="26" FontSize="11" Padding="6,0"
                               VerticalContentAlignment="Center"/>
                </Grid>

                <!-- BORDER ─────────────────────────────────────────── -->
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,10,0,4">
                    <TextBlock Text="BORDER" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Padding="0,0,0,2"/>
                </Border>

                <!-- Show Border -->
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Show Border" Style="{StaticResource SettingLabel}"/>
                    <CheckBox  Grid.Column="1" IsChecked="{Binding ShowBorder, Mode=TwoWay}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Border Thickness -->
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Border Width" Style="{StaticResource SettingLabel}"/>
                    <TextBox   Grid.Column="1" Text="{Binding BorderThickness, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                               Height="26" FontSize="11" Padding="6,0"
                               VerticalContentAlignment="Center"/>
                </Grid>

                <!-- Border Color -->
                <Grid Style="{StaticResource ColorRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="26"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Border Color" Style="{StaticResource SettingLabel}"/>
                    <TextBox   Grid.Column="1" Text="{Binding BorderColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                               Height="26" FontSize="11" Padding="6,0"
                               VerticalContentAlignment="Center"/>
                    <Button    Grid.Column="2" Style="{StaticResource ColorSwatchButton}"
                               Background="{Binding BorderColor, Converter={StaticResource HexToBrush}}"
                               Tag="BorderColor" Click="ColorSwatch_Click"/>
                </Grid>

                <!-- TITLE BAR STYLE ─────────────────────────────────── -->
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,10,0,4">
                    <TextBlock Text="TITLE BAR STYLE" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Padding="0,0,0,2"/>
                </Border>

                <!-- Title Background -->
                <Grid Style="{StaticResource ColorRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="26"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Title Background" Style="{StaticResource SettingLabel}"/>
                    <TextBox   Grid.Column="1" Text="{Binding TitleBgColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                               Height="26" FontSize="11" Padding="6,0"
                               VerticalContentAlignment="Center"/>
                    <Button    Grid.Column="2" Style="{StaticResource ColorSwatchButton}"
                               Background="{Binding TitleBgColor, Converter={StaticResource HexToBrush}}"
                               Tag="TitleBgColor" Click="ColorSwatch_Click"/>
                </Grid>

                <!-- Title Font Color -->
                <Grid Style="{StaticResource ColorRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="26"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Title Font Color" Style="{StaticResource SettingLabel}"/>
                    <TextBox   Grid.Column="1" Text="{Binding TitleFontColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                               Height="26" FontSize="11" Padding="6,0"
                               VerticalContentAlignment="Center"/>
                    <Button    Grid.Column="2" Style="{StaticResource ColorSwatchButton}"
                               Background="{Binding TitleFontColor, Converter={StaticResource HexToBrush}}"
                               Tag="TitleFontColor" Click="ColorSwatch_Click"/>
                </Grid>

                <!-- Title Bold -->
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Title Bold" Style="{StaticResource SettingLabel}"/>
                    <CheckBox  Grid.Column="1" IsChecked="{Binding TitleBold, Mode=TwoWay}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Reset Section button -->
                <Button Content="↺  Reset Section to Default"
                        Command="{Binding ResetCommand}"
                        HorizontalAlignment="Left"
                        Margin="0,10,0,0" Padding="10,4"
                        FontSize="11"
                        Style="{StaticResource ActionButton}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <!-- ═══ MAIN LAYOUT ═══════════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Page header -->
            <RowDefinition Height="*"/>     <!-- Content     -->
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Border Grid.Row="0" Background="White" Padding="24,16"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="Report Design &amp; Print Settings"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="360"/>  <!-- Settings panel -->
            <ColumnDefinition Width="2*" MinWidth="280"/>  <!-- Live preview   -->
        </Grid.ColumnDefinitions>

        <!-- ══ LEFT: Settings ══════════════════════════════════════════════ -->
        <DockPanel Grid.Column="0">

            <!-- Toolbar -->
            <Border DockPanel.Dock="Top"
                    Background="White" Padding="14,10"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <WrapPanel Orientation="Horizontal">

                    <!-- Global font -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Global Font:" VerticalAlignment="Center"
                                   FontSize="11" Margin="0,0,6,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <ComboBox x:Name="GlobalFontCombo"
                                  ItemsSource="{x:Static vm:SectionStyleVm.AvailableFonts}"
                                  SelectedItem="{Binding GlobalFontFamily, Mode=TwoWay}"
                                  Width="130" Height="26" FontSize="11"/>
                    </StackPanel>

                    <!-- Logo size -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Logo size:" VerticalAlignment="Center"
                                   FontSize="11" Margin="0,0,6,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Slider Minimum="30" Maximum="90"
                                Value="{Binding LogoSize, Mode=TwoWay}"
                                Width="90" VerticalAlignment="Center"
                                TickFrequency="2" IsSnapToTickEnabled="True"/>
                        <TextBlock VerticalAlignment="Center" FontSize="11" Margin="5,0,0,0" Width="34"
                                   Text="{Binding LogoSize, StringFormat='{}{0:F0} pt'}"/>
                    </StackPanel>

                    <!-- B&W toggle -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <CheckBox IsChecked="{Binding BlackAndWhiteMode, Mode=TwoWay}"
                                  VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="B&amp;W Print Mode" VerticalAlignment="Center" FontSize="11"/>
                    </StackPanel>

                    <!-- Apply B&W palette -->
                    <Button Content="Apply B&amp;W Palette"
                            Command="{Binding ApplyBwPaletteCommand}"
                            Style="{StaticResource ActionButton}"
                            Padding="10,4" FontSize="11" Margin="0,0,8,0"/>

                    <!-- Save -->
                    <Button Content="💾  Save Settings"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Padding="12,4" FontSize="11" Margin="0,0,8,0"/>

                    <!-- Reset All -->
                    <Button Content="↺  Reset All"
                            Command="{Binding ResetAllCommand}"
                            Style="{StaticResource ActionButton}"
                            Padding="10,4" FontSize="11"/>
                </WrapPanel>
            </Border>

            <!-- Status bar -->
            <Border DockPanel.Dock="Top"
                    Visibility="{Binding StatusVisible, Converter={StaticResource BoolToVisible}}"
                    Padding="14,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#D1FAE5"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Background" Value="#FEE2E2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </Border>

            <!-- Scrollable settings -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,8,14,20">
                <StackPanel>

                    <!-- ── CLINIC NAME — ENGLISH ─────────────────── -->
                    <Expander IsExpanded="False" Margin="0,6,0,0">
                        <Expander.Header>
                            <TextBlock Text="🏥  Clinic Name — English  (left column)"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="12">
                            <ContentControl DataContext="{Binding ClinicNameEn}"
                                            ContentTemplate="{StaticResource SectionTemplate}"
                                            Content="{Binding}"/>
                        </Border>
                    </Expander>

                    <!-- ── CLINIC NAME — DARI ─────────────────────── -->
                    <Expander IsExpanded="False" Margin="0,6,0,0">
                        <Expander.Header>
                            <TextBlock Text="🏥  Clinic Name — دری  (right column)"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="12">
                            <ContentControl DataContext="{Binding ClinicNameDari}"
                                            ContentTemplate="{StaticResource SectionTemplate}"
                                            Content="{Binding}"/>
                        </Border>
                    </Expander>

                    <!-- ── TAGLINE ────────────────────────────────── -->
                    <Expander IsExpanded="False" Margin="0,6,0,0">
                        <Expander.Header>
                            <TextBlock Text="✍  Tagline / Motto  (printed below logo)"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="12">
                            <ContentControl DataContext="{Binding Tagline}"
                                            ContentTemplate="{StaticResource SectionTemplate}"
                                            Content="{Binding}"/>
                        </Border>
                    </Expander>

                    <!-- ── HEADER — DOCTOR NAME (EN) ────────────── -->
                    <Expander IsExpanded="True" Margin="0,6,0,0">
                        <Expander.Header>
                            <TextBlock Text="👨‍⚕️  Doctor Name — English"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="12">
                            <ContentControl DataContext="{Binding DoctorNameEn}"
                                            ContentTemplate="{StaticResource SectionTemplate}"
                                            Content="{Binding}"/>
                        </Border>
                    </Expander>

                    <!-- ── HEADER — SPECIALITY (EN) ─────────────── -->
                    <Expander IsExpanded="False" Margin="0,6,0,0">
                        <Expander.Header>
                            <TextBlock Text="🏥  Speciality — English"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="12">
                            <ContentControl DataContext="{Binding SpecialityEn}"
                                            ContentTemplate="{StaticResource SectionTemplate}"
                                            Content="{Binding}"/>
                        </Border>
                    </Expander>

                    <!-- ── HEADER — OTHER SPECIALITY (EN) ───────── -->
                    <Expander IsExpanded="False" Margin="0,6,0,0">
                        <Expander.Header>
                            <TextBlock Text="📋  Other Speciality — English"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="12">
                            <ContentControl DataContext="{Binding OtherSpecialityEn}"
                                            ContentTemplate="{StaticResource SectionTemplate}"
                                            Content="{Binding}"/>
                        </Border>
                    </Expander>

                    <!-- ── HEADER — DOCTOR NAME (DARI) ──────────── -->
                    <Expander IsExpanded="False" Margin="0,6,0,0">
                        <Expander.Header>
                            <TextBlock Text="👨‍⚕️  Doctor Name — Dari  (نام داکتر)"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="12">
                            <ContentControl DataContext="{Binding DoctorNameDari}"
                                            ContentTemplate="{StaticResource SectionTemplate}"
                                            Content="{Binding}"/>
                        </Border>
                    </Expander>

                    <!-- ── HEADER — SPECIALITY (DARI) ───────────── -->
                    <Expander IsExpanded="False" Margin="0,6,0,0">
                        <Expander.Header>
                            <TextBlock Text="🏥  Speciality — Dari  (تخصص)"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="12">
                            <ContentControl DataContext="{Binding SpecialityDari}"
                                            ContentTemplate="{StaticResource SectionTemplate}"
                                            Content="{Binding}"/>
                        </Border>
                    </Expander>

                    <!-- ── HEADER — OTHER SPECIALITY (DARI) ─────── -->
                    <Expander IsExpanded="False" Margin="0,6,0,0">
                        <Expander.Header>
                            <TextBlock Text="📋  Other Speciality — Dari  (تخصص دیگر)"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="12">
                            <ContentControl DataContext="{Binding OtherSpecialityDari}"
                                            ContentTemplate="{StaticResource SectionTemplate}"
                                            Content="{Binding}"/>
                        </Border>
                    </Expander>

                    <!-- ── HEADER DIVIDER ────────────────────────── -->
                    <Expander IsExpanded="False" Margin="0,6,0,0">
                        <Expander.Header>
                            <TextBlock Text="➖  Header Divider Line"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="12">
                            <StackPanel>
                                <!-- Show / hide -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <CheckBox IsChecked="{Binding DividerVisible, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Show divider line" VerticalAlignment="Center" FontSize="11"/>
                                </StackPanel>
                                <!-- Thickness -->
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="38"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Thickness" Style="{StaticResource SettingLabel}"/>
                                    <Slider Grid.Column="1"
                                            Minimum="0.5" Maximum="8"
                                            Value="{Binding DividerThickness, Mode=TwoWay}"
                                            TickFrequency="0.5" SmallChange="0.5" LargeChange="1"
                                            IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding DividerThickness, StringFormat='{}{0:F1}'}"
                                               FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                                <!-- Color -->
                                <Grid Style="{StaticResource SettingRow}" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Color" Style="{StaticResource SettingLabel}"/>
                                    <TextBox   Grid.Column="1" Text="{Binding DividerColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                               Height="26" FontSize="11" Padding="6,0" VerticalContentAlignment="Center"/>
                                    <Button    Grid.Column="2" Style="{StaticResource ColorSwatchButton}"
                                               Background="{Binding DividerColor, Converter={StaticResource HexToBrush}}"
                                               Click="DividerColorSwatch_Click"/>
                                </Grid>
                                <!-- Style -->
                                <Grid Style="{StaticResource SettingRow}" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Line style" Style="{StaticResource SettingLabel}"/>
                                    <ComboBox  Grid.Column="1"
                                               ItemsSource="{x:Static vm:ReportDesignViewModel.DividerStyleOptions}"
                                               SelectedItem="{Binding DividerStyle, Mode=TwoWay}"
                                               Height="26" FontSize="11"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <!-- ── PATIENT BAR ────────────────────────────── -->
                    <Expander IsExpanded="False" Margin="0,6,0,0">
                        <Expander.Header>
                            <TextBlock Text="👤  Patient Information Bar"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="12">
                            <StackPanel>
                                <!-- Gap between divider and patient bar -->
                                <TextBlock Text="Gap above bar (pt)" FontSize="11" Margin="0,0,0,4"/>
                                <Slider Minimum="0" Maximum="30" SmallChange="1" LargeChange="4"
                                        IsSnapToTickEnabled="True" TickFrequency="1"
                                        Value="{Binding PatientBarGap, Mode=TwoWay}"
                                        Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding PatientBarGap, StringFormat={}{0:0} pt}"
                                           FontSize="10" Foreground="Gray" Margin="0,0,0,10"/>

                                <!-- Show Patient ID row toggle -->
                                <CheckBox Content="Show Patient ID row"
                                          IsChecked="{Binding ShowPatientId, Mode=TwoWay}"
                                          Margin="0,0,0,12"/>

                                <Separator Margin="0,0,0,10"/>

                                <ContentControl DataContext="{Binding PatientBar}"
                                                ContentTemplate="{StaticResource SectionTemplate}"
                                                Content="{Binding}"/>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <!-- ── PATIENT ID ROW ─────────────────────────── -->
                    <Expander IsExpanded="False" Margin="0,6,0,0">
                        <Expander.Header>
                            <TextBlock Text="🪪  Patient ID Row"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="12">
                            <ContentControl DataContext="{Binding PatientId}"
                                            ContentTemplate="{StaticResource SectionTemplate}"
                                            Content="{Binding}"/>
                        </Border>
                    </Expander>

                    <!-- ── VITAL SIGNS ────────────────────────────── -->
                    <Expander IsExpanded="False" Margin="0,6,0,0">
                        <Expander.Header>
                            <TextBlock Text="🩺  Vital Signs Box"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="12">
                            <StackPanel>
                                <ContentControl DataContext="{Binding VitalSigns}"
                                                ContentTemplate="{StaticResource SectionTemplate}"
                                                Content="{Binding}"/>
                                <!-- Vital Signs–specific: label spacing -->
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="4,10,4,4">
                                    <TextBlock Text="VITAL SIGNS LAYOUT" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" Padding="0,0,0,2"/>
                                </Border>
                                <Grid Style="{StaticResource SettingRow}" Margin="4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Label Spacing (pt)" Style="{StaticResource SettingLabel}"
                                               ToolTip="Space between the vital-sign label (BP:) and its value (120/80) in the printed report"/>
                                    <TextBox   Grid.Column="1"
                                               Text="{Binding VitalSigns.LabelSpacing, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                               Height="26" FontSize="11" Padding="6,0" VerticalContentAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <!-- ── CLINICAL FINDINGS ──────────────────────── -->
                    <Expander IsExpanded="False" Margin="0,6,0,0">
                        <Expander.Header>
                            <TextBlock Text="📝  Clinical Findings Box"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="12">
                            <ContentControl DataContext="{Binding ClinicalFindings}"
                                            ContentTemplate="{StaticResource SectionTemplate}"
                                            Content="{Binding}"/>
                        </Border>
                    </Expander>

                    <!-- ── DIAGNOSIS ──────────────────────────────── -->
                    <Expander IsExpanded="False" Margin="0,6,0,0">
                        <Expander.Header>
                            <TextBlock Text="🔬  Diagnosis Box"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="12">
                            <ContentControl DataContext="{Binding Diagnosis}"
                                            ContentTemplate="{StaticResource SectionTemplate}"
                                            Content="{Binding}"/>
                        </Border>
                    </Expander>

                    <!-- ── LAB TESTS ──────────────────────────────── -->
                    <Expander IsExpanded="False" Margin="0,6,0,0">
                        <Expander.Header>
                            <TextBlock Text="🧪  Lab Tests Box"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="12">
                            <ContentControl DataContext="{Binding LabTests}"
                                            ContentTemplate="{StaticResource SectionTemplate}"
                                            Content="{Binding}"/>
                        </Border>
                    </Expander>

                    <!-- ── Rx SECTION ─────────────────────────────── -->
                    <Expander IsExpanded="False" Margin="0,6,0,0">
                        <Expander.Header>
                            <TextBlock Text="💊  Prescription (Rx) Section"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="12">
                            <ContentControl DataContext="{Binding RxSection}"
                                            ContentTemplate="{StaticResource SectionTemplate}"
                                            Content="{Binding}"/>
                        </Border>
                    </Expander>

                    <!-- ── FOOTER ─────────────────────────────────── -->
                    <Expander IsExpanded="False" Margin="0,6,0,0">
                        <Expander.Header>
                            <TextBlock Text="📞  Footer Section  (Contact / Address)"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="12">
                            <ContentControl DataContext="{Binding Footer}"
                                            ContentTemplate="{StaticResource SectionTemplate}"
                                            Content="{Binding}"/>
                        </Border>
                    </Expander>

                    <!-- ── FOOTER DIVIDER ─────────────────────────── -->
                    <Expander IsExpanded="False" Margin="0,6,0,0">
                        <Expander.Header>
                            <TextBlock Text="➖  Footer Divider Line"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <CheckBox IsChecked="{Binding FooterDividerVisible, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Show divider line" VerticalAlignment="Center" FontSize="11"/>
                                </StackPanel>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="38"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Thickness" Style="{StaticResource SettingLabel}"/>
                                    <Slider Grid.Column="1"
                                            Minimum="0.5" Maximum="8"
                                            Value="{Binding FooterDividerThickness, Mode=TwoWay}"
                                            TickFrequency="0.5" SmallChange="0.5" LargeChange="1"
                                            IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding FooterDividerThickness, StringFormat='{}{0:F1}'}"
                                               FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Color" Style="{StaticResource SettingLabel}"/>
                                    <TextBox   Grid.Column="1" Text="{Binding FooterDividerColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                               Height="26" FontSize="11" Padding="6,0" VerticalContentAlignment="Center"/>
                                    <Button    Grid.Column="2" Style="{StaticResource ColorSwatchButton}"
                                               Background="{Binding FooterDividerColor, Converter={StaticResource HexToBrush}}"
                                               Click="FooterDividerColorSwatch_Click"/>
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Line style" Style="{StaticResource SettingLabel}"/>
                                    <ComboBox  Grid.Column="1"
                                               ItemsSource="{x:Static vm:ReportDesignViewModel.DividerStyleOptions}"
                                               SelectedItem="{Binding FooterDividerStyle, Mode=TwoWay}"
                                               Height="26" FontSize="11"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Expander>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- ── Vertical divider ──────────────────────────────────────────── -->
        <Border Grid.Column="0" HorizontalAlignment="Right" Width="1"
                Background="{StaticResource BorderBrush}"/>

        <!-- ══ RIGHT: Live Preview ═════════════════════════════════════════ -->
        <DockPanel Grid.Column="1" Background="#F3F4F6">

            <!-- Preview header -->
            <Border DockPanel.Dock="Top" Background="White" Padding="12,8"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <TextBlock Text="Live Preview" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </Border>

            <!-- A4 page preview (Viewbox scales to fit) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                          Padding="16">
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                    <!-- 595 × 842 ≈ A4 proportions in WPF units -->
                    <Border Width="595" Height="842" Background="White"
                            BorderBrush="#CCCCCC" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="4" BlurRadius="8"
                                              Color="#AAAAAA" Opacity="0.4"/>
                        </Border.Effect>

                        <Grid Margin="28,22,28,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>  <!-- Header     -->
                                <RowDefinition Height="Auto"/>  <!-- Divider gap-->
                                <RowDefinition Height="Auto"/>  <!-- Patient bar-->
                                <RowDefinition Height="*"/>     <!-- Body       -->
                                <RowDefinition Height="Auto"/>  <!-- Footer     -->
                            </Grid.RowDefinitions>

                            <!-- ── HEADER ──────────────────────────────── -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>   <!-- Left: EN         -->
                                    <ColumnDefinition Width="70"/>  <!-- Middle: Logo     -->
                                    <ColumnDefinition Width="*"/>   <!-- Right: Dari      -->
                                </Grid.ColumnDefinitions>

                                <!-- Left: EN column -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="OPD Clinic Name"
                                               FontFamily="{Binding ClinicNameEn.FontFamilyWpf}"
                                               FontSize="{Binding ClinicNameEn.FontSizeWpf}"
                                               FontWeight="{Binding ClinicNameEn.FontWeightWpf}"
                                               FontStyle="{Binding ClinicNameEn.FontStyleWpf}"
                                               TextAlignment="{Binding ClinicNameEn.TextAlignmentWpf}"
                                               Foreground="{Binding ClinicNameEn.FontColorBrush}"/>
                                    <TextBlock Text="Dr. Ahmad Karimi"
                                               FontFamily="{Binding DoctorNameEn.FontFamilyWpf}"
                                               FontSize="{Binding DoctorNameEn.FontSizeWpf}"
                                               FontWeight="{Binding DoctorNameEn.FontWeightWpf}"
                                               FontStyle="{Binding DoctorNameEn.FontStyleWpf}"
                                               TextAlignment="{Binding DoctorNameEn.TextAlignmentWpf}"
                                               Foreground="{Binding DoctorNameEn.FontColorBrush}"/>
                                    <TextBlock Text="Gynecologist &amp; Obstetrician"
                                               FontFamily="{Binding SpecialityEn.FontFamilyWpf}"
                                               FontSize="{Binding SpecialityEn.FontSizeWpf}"
                                               FontWeight="{Binding SpecialityEn.FontWeightWpf}"
                                               FontStyle="{Binding SpecialityEn.FontStyleWpf}"
                                               Margin="0,2,0,0"
                                               TextAlignment="{Binding SpecialityEn.TextAlignmentWpf}"
                                               Foreground="{Binding SpecialityEn.FontColorBrush}"/>
                                    <TextBlock Text="Internal Medicine"
                                               FontFamily="{Binding OtherSpecialityEn.FontFamilyWpf}"
                                               FontSize="{Binding OtherSpecialityEn.FontSizeWpf}"
                                               FontWeight="{Binding OtherSpecialityEn.FontWeightWpf}"
                                               FontStyle="{Binding OtherSpecialityEn.FontStyleWpf}"
                                               Margin="0,1,0,0"
                                               TextAlignment="{Binding OtherSpecialityEn.TextAlignmentWpf}"
                                               Foreground="{Binding OtherSpecialityEn.FontColorBrush}"/>
                                </StackPanel>

                                <!-- Centre: logo at top, tagline pinned to bottom -->
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Width="{Binding LogoSize}"
                                            Height="{Binding LogoSize}"
                                            CornerRadius="27"
                                            HorizontalAlignment="Center"
                                            BorderBrush="{Binding DoctorNameEn.FontColorBrush}"
                                            BorderThickness="1.5"
                                            Background="{Binding DoctorNameEn.TitleBgBrush}">
                                        <TextBlock Text="AK" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding DoctorNameEn.FontColorBrush}"/>
                                    </Border>
                                    <TextBlock Grid.Row="1" Text="Your tagline here"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Bottom"
                                               TextAlignment="Center"
                                               Margin="0,2,0,0"
                                               FontFamily="{Binding Tagline.FontFamilyWpf}"
                                               FontSize="{Binding Tagline.FontSizeWpf}"
                                               FontWeight="{Binding Tagline.FontWeightWpf}"
                                               FontStyle="{Binding Tagline.FontStyleWpf}"
                                               Foreground="{Binding Tagline.FontColorBrush}"/>
                                </Grid>

                                <!-- Right: Dari column (RTL) -->
                                <StackPanel Grid.Column="2" FlowDirection="RightToLeft">
                                    <TextBlock Text="نام کلینیک"
                                               FontFamily="{Binding ClinicNameDari.FontFamilyWpf}"
                                               FontSize="{Binding ClinicNameDari.FontSizeWpf}"
                                               FontWeight="{Binding ClinicNameDari.FontWeightWpf}"
                                               FontStyle="{Binding ClinicNameDari.FontStyleWpf}"
                                               TextAlignment="{Binding ClinicNameDari.TextAlignmentWpfRtl}"
                                               Foreground="{Binding ClinicNameDari.FontColorBrush}"/>
                                    <TextBlock Text="دکتر احمد کریمی"
                                               FontFamily="{Binding DoctorNameDari.FontFamilyWpf}"
                                               FontSize="{Binding DoctorNameDari.FontSizeWpf}"
                                               FontWeight="{Binding DoctorNameDari.FontWeightWpf}"
                                               FontStyle="{Binding DoctorNameDari.FontStyleWpf}"
                                               TextAlignment="{Binding DoctorNameDari.TextAlignmentWpfRtl}"
                                               Foreground="{Binding DoctorNameDari.FontColorBrush}"/>
                                    <TextBlock Text="متخصص زنان و مامایی"
                                               FontFamily="{Binding SpecialityDari.FontFamilyWpf}"
                                               FontSize="{Binding SpecialityDari.FontSizeWpf}"
                                               FontWeight="{Binding SpecialityDari.FontWeightWpf}"
                                               FontStyle="{Binding SpecialityDari.FontStyleWpf}"
                                               Margin="0,2,0,0"
                                               TextAlignment="{Binding SpecialityDari.TextAlignmentWpfRtl}"
                                               Foreground="{Binding SpecialityDari.FontColorBrush}"/>
                                    <TextBlock Text="طب داخله"
                                               FontFamily="{Binding OtherSpecialityDari.FontFamilyWpf}"
                                               FontSize="{Binding OtherSpecialityDari.FontSizeWpf}"
                                               FontWeight="{Binding OtherSpecialityDari.FontWeightWpf}"
                                               FontStyle="{Binding OtherSpecialityDari.FontStyleWpf}"
                                               Margin="0,1,0,0"
                                               TextAlignment="{Binding OtherSpecialityDari.TextAlignmentWpfRtl}"
                                               Foreground="{Binding OtherSpecialityDari.FontColorBrush}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Divider line -->
                            <Grid Grid.Row="1" Margin="0,5,0,3"
                                  Visibility="{Binding DividerVisible, Converter={StaticResource BoolToVisible}}">
                                <!-- Solid / Dashed / Dotted -->
                                <Path Data="M 0,0.5 L 1,0.5" Stretch="Fill"
                                      Stroke="{Binding DividerBrush}"
                                      StrokeThickness="{Binding DividerThickness}"
                                      StrokeDashArray="{Binding DividerDashArrayWpf}"
                                      Visibility="{Binding DividerIsSingle, Converter={StaticResource BoolToVisible}}"/>
                                <!-- Double -->
                                <StackPanel Visibility="{Binding DividerIsDouble, Converter={StaticResource BoolToVisible}}">
                                    <Path Data="M 0,0.5 L 1,0.5" Stretch="Fill"
                                          Stroke="{Binding DividerBrush}" StrokeThickness="{Binding DividerThickness}"/>
                                    <Path Data="M 0,0.5 L 1,0.5" Stretch="Fill" Margin="0,3,0,0"
                                          Stroke="{Binding DividerBrush}" StrokeThickness="{Binding DividerThickness}"/>
                                </StackPanel>
                            </Grid>

                            <!-- ── PATIENT BAR ─────────────────────── -->
                            <Border Grid.Row="2"
                                    Background="{Binding PatientBar.BgBrush}"
                                    BorderBrush="{Binding PatientBar.BorderColorBrush}"
                                    BorderThickness="{Binding PatientBar.BorderThicknessWpf}"
                                    Padding="{Binding PatientBar.PaddingThicknessWpf}">
                                <StackPanel>
                                    <!-- Row 1 RTL: Name | Age | Sex | Date (right→left) -->
                                    <Grid FlowDirection="RightToLeft">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="3*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Name (rightmost in RTL = col 0) -->
                                        <TextBlock Grid.Column="0"
                                                   FlowDirection="RightToLeft"
                                                   FontFamily="{Binding PatientBar.FontFamilyWpf}"
                                                   FontSize="{Binding PatientBar.FontSizeWpf}"
                                                   FontWeight="{Binding PatientBar.FontWeightWpf}"
                                                   FontStyle="{Binding PatientBar.FontStyleWpf}"
                                                   Foreground="{Binding PatientBar.FontColorBrush}">
                                            <Run Text="نام مریض:" FontWeight="Bold"/>
                                            <Run Text=" زینب محمدی"/>
                                        </TextBlock>
                                        <!-- Age -->
                                        <TextBlock Grid.Column="2" HorizontalAlignment="Center"
                                                   FlowDirection="RightToLeft"
                                                   FontFamily="{Binding PatientBar.FontFamilyWpf}"
                                                   FontSize="{Binding PatientBar.FontSizeWpf}"
                                                   FontWeight="{Binding PatientBar.FontWeightWpf}"
                                                   FontStyle="{Binding PatientBar.FontStyleWpf}"
                                                   Foreground="{Binding PatientBar.FontColorBrush}">
                                            <Run Text="سن:" FontWeight="Bold"/>
                                            <Run Text=" 28"/>
                                        </TextBlock>
                                        <!-- Sex -->
                                        <TextBlock Grid.Column="4" HorizontalAlignment="Center"
                                                   FlowDirection="RightToLeft"
                                                   FontFamily="{Binding PatientBar.FontFamilyWpf}"
                                                   FontSize="{Binding PatientBar.FontSizeWpf}"
                                                   FontWeight="{Binding PatientBar.FontWeightWpf}"
                                                   FontStyle="{Binding PatientBar.FontStyleWpf}"
                                                   Foreground="{Binding PatientBar.FontColorBrush}">
                                            <Run Text="جنسیت:" FontWeight="Bold"/>
                                            <Run Text=" زن"/>
                                        </TextBlock>
                                        <!-- Date (leftmost in RTL = col 6) -->
                                        <TextBlock Grid.Column="6" HorizontalAlignment="Left"
                                                   FlowDirection="RightToLeft"
                                                   FontFamily="{Binding PatientBar.FontFamilyWpf}"
                                                   FontSize="{Binding PatientBar.FontSizeWpf}"
                                                   FontWeight="{Binding PatientBar.FontWeightWpf}"
                                                   FontStyle="{Binding PatientBar.FontStyleWpf}"
                                                   Foreground="{Binding PatientBar.FontColorBrush}">
                                            <Run Text="تاریخ:" FontWeight="Bold"/>
                                            <Run Text=" ۱۴۰۳/۰۱/۱۵"/>
                                        </TextBlock>
                                    </Grid>
                                    <!-- Row 2: Patient ID (optional) -->
                                    <TextBlock Margin="0,4,0,0"
                                               FlowDirection="RightToLeft"
                                               Visibility="{Binding ShowPatientId, Converter={StaticResource BoolToVisible}}"
                                               FontFamily="{Binding PatientId.FontFamilyWpf}"
                                               FontSize="{Binding PatientId.FontSizeWpf}"
                                               FontWeight="{Binding PatientId.FontWeightWpf}"
                                               FontStyle="{Binding PatientId.FontStyleWpf}"
                                               Foreground="{Binding PatientId.FontColorBrush}">
                                        <Run Text="نمبر مسلسل:" FontWeight="Bold"/>
                                        <Run Text=" PT-2024-0042"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- ── BODY ───────────────────────────── -->
                            <Grid Grid.Row="3" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="2.6*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left column: boxes -->
                                <StackPanel Grid.Column="0">

                                    <!-- Vital Signs -->
                                    <Border BorderBrush="{Binding VitalSigns.BorderColorBrush}"
                                            BorderThickness="{Binding VitalSigns.BorderThicknessWpf}"
                                            Background="{Binding VitalSigns.BgBrush}"
                                            Margin="0,0,0,6">
                                        <StackPanel>
                                            <Border Background="{Binding VitalSigns.TitleBgBrush}"
                                                    Padding="5,3">
                                                <TextBlock Text="Vital Signs"
                                                           FontFamily="{Binding VitalSigns.FontFamilyWpf}"
                                                           FontSize="8.5" FontWeight="{Binding VitalSigns.TitleFontWeightWpf}"
                                                           Foreground="{Binding VitalSigns.TitleFontBrush}"/>
                                            </Border>
                                            <StackPanel Margin="{Binding VitalSigns.PaddingThicknessWpf}">
                                                <TextBlock FontFamily="{Binding VitalSigns.FontFamilyWpf}"
                                                           FontSize="{Binding VitalSigns.FontSizeWpf}"
                                                           FontStyle="{Binding VitalSigns.FontStyleWpf}"
                                                           Foreground="{Binding VitalSigns.FontColorBrush}">
                                                    <Run Text="BP:" FontWeight="Bold"/><Run Text="  120/80    "/>
                                                    <Run Text="PR:" FontWeight="Bold"/><Run Text="  76"/>
                                                </TextBlock>
                                                <TextBlock FontFamily="{Binding VitalSigns.FontFamilyWpf}"
                                                           FontSize="{Binding VitalSigns.FontSizeWpf}"
                                                           FontStyle="{Binding VitalSigns.FontStyleWpf}"
                                                           Foreground="{Binding VitalSigns.FontColorBrush}"
                                                           Margin="0,3,0,0">
                                                    <Run Text="BT:" FontWeight="Bold"/><Run Text="  37.1    "/>
                                                    <Run Text="BW:" FontWeight="Bold"/><Run Text="  62 kg"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Clinical Findings -->
                                    <Border BorderBrush="{Binding ClinicalFindings.BorderColorBrush}"
                                            BorderThickness="{Binding ClinicalFindings.BorderThicknessWpf}"
                                            Background="{Binding ClinicalFindings.BgBrush}"
                                            Margin="0,0,0,6">
                                        <StackPanel>
                                            <Border Background="{Binding ClinicalFindings.TitleBgBrush}" Padding="5,3">
                                                <TextBlock Text="Clinical Findings"
                                                           FontFamily="{Binding ClinicalFindings.FontFamilyWpf}"
                                                           FontSize="8.5" FontWeight="{Binding ClinicalFindings.TitleFontWeightWpf}"
                                                           Foreground="{Binding ClinicalFindings.TitleFontBrush}"/>
                                            </Border>
                                            <TextBlock Text="Lower abdominal pain, nausea."
                                                       FontFamily="{Binding ClinicalFindings.FontFamilyWpf}"
                                                       FontSize="{Binding ClinicalFindings.FontSizeWpf}"
                                                       FontWeight="{Binding ClinicalFindings.FontWeightWpf}"
                                                       FontStyle="{Binding ClinicalFindings.FontStyleWpf}"
                                                       TextAlignment="{Binding ClinicalFindings.TextAlignmentWpf}"
                                                       Foreground="{Binding ClinicalFindings.FontColorBrush}"
                                                       Margin="{Binding ClinicalFindings.PaddingThicknessWpf}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Diagnosis -->
                                    <Border BorderBrush="{Binding Diagnosis.BorderColorBrush}"
                                            BorderThickness="{Binding Diagnosis.BorderThicknessWpf}"
                                            Background="{Binding Diagnosis.BgBrush}"
                                            Margin="0,0,0,6">
                                        <StackPanel>
                                            <Border Background="{Binding Diagnosis.TitleBgBrush}" Padding="5,3">
                                                <TextBlock Text="Diagnosis"
                                                           FontFamily="{Binding Diagnosis.FontFamilyWpf}"
                                                           FontSize="8.5" FontWeight="{Binding Diagnosis.TitleFontWeightWpf}"
                                                           Foreground="{Binding Diagnosis.TitleFontBrush}"/>
                                            </Border>
                                            <TextBlock Text="Pelvic Inflammatory Disease"
                                                       FontFamily="{Binding Diagnosis.FontFamilyWpf}"
                                                       FontSize="{Binding Diagnosis.FontSizeWpf}"
                                                       FontWeight="{Binding Diagnosis.FontWeightWpf}"
                                                       FontStyle="{Binding Diagnosis.FontStyleWpf}"
                                                       TextAlignment="{Binding Diagnosis.TextAlignmentWpf}"
                                                       Foreground="{Binding Diagnosis.FontColorBrush}"
                                                       Margin="{Binding Diagnosis.PaddingThicknessWpf}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Lab Tests -->
                                    <Border BorderBrush="{Binding LabTests.BorderColorBrush}"
                                            BorderThickness="{Binding LabTests.BorderThicknessWpf}"
                                            Background="{Binding LabTests.BgBrush}">
                                        <StackPanel>
                                            <Border Background="{Binding LabTests.TitleBgBrush}" Padding="5,3">
                                                <TextBlock Text="Lab Tests"
                                                           FontFamily="{Binding LabTests.FontFamilyWpf}"
                                                           FontSize="8.5" FontWeight="{Binding LabTests.TitleFontWeightWpf}"
                                                           Foreground="{Binding LabTests.TitleFontBrush}"/>
                                            </Border>
                                            <TextBlock Text="CBC   •   CRP   •   Urine R/E"
                                                       FontFamily="{Binding LabTests.FontFamilyWpf}"
                                                       FontSize="{Binding LabTests.FontSizeWpf}"
                                                       FontWeight="{Binding LabTests.FontWeightWpf}"
                                                       FontStyle="{Binding LabTests.FontStyleWpf}"
                                                       TextAlignment="{Binding LabTests.TextAlignmentWpf}"
                                                       Foreground="{Binding LabTests.FontColorBrush}"
                                                       Margin="{Binding LabTests.PaddingThicknessWpf}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Right column: Rx -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Rx" FontSize="22" FontStyle="Italic"
                                               FontFamily="{Binding RxSection.FontFamilyWpf}"
                                               FontWeight="{Binding RxSection.FontWeightWpf}"
                                               Foreground="{Binding RxSection.FontColorBrush}"
                                               Margin="0,0,0,6"/>

                                    <!-- Rx line 1 -->
                                    <Border BorderBrush="{Binding RxSection.BorderColorBrush}"
                                            BorderThickness="0,0,0,0.5"
                                            Padding="{Binding RxSection.PaddingThicknessWpf}">
                                        <StackPanel>
                                            <TextBlock FontFamily="{Binding RxSection.FontFamilyWpf}"
                                                       FontSize="{Binding RxSection.FontSizeWpf}"
                                                       FontStyle="{Binding RxSection.FontStyleWpf}"
                                                       TextAlignment="{Binding RxSection.TextAlignmentWpf}"
                                                       Foreground="{Binding RxSection.FontColorBrush}">
                                                <Run Text="1 )" FontWeight="Bold"
                                                     Foreground="{Binding RxSection.FontColorBrush}"/>
                                                <Run Text="  Tab  " Foreground="{Binding RxSection.FontColorBrush}"/>
                                                <Run Text="Amoxicillin  500mg" FontWeight="Bold"/>
                                            </TextBlock>
                                            <TextBlock Text="    N = 21"
                                                       FontFamily="{Binding RxSection.FontFamilyWpf}"
                                                       FontSize="8.5"
                                                       FontStyle="{Binding RxSection.FontStyleWpf}"
                                                       Foreground="{Binding RxSection.FontColorBrush}"
                                                       Margin="0,2,0,0"/>
                                            <TextBlock Text="دو بار در روز بعد از غذا"
                                                       FontFamily="{Binding RxSection.FontFamilyWpf}"
                                                       FontSize="9"
                                                       FontStyle="{Binding RxSection.FontStyleWpf}"
                                                       Foreground="{Binding RxSection.FontColorBrush}"
                                                       HorizontalAlignment="Right"
                                                       FlowDirection="RightToLeft"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Rx line 2 -->
                                    <Border BorderBrush="{Binding RxSection.BorderColorBrush}"
                                            BorderThickness="0,0,0,0.5"
                                            Padding="{Binding RxSection.PaddingThicknessWpf}">
                                        <StackPanel>
                                            <TextBlock FontFamily="{Binding RxSection.FontFamilyWpf}"
                                                       FontSize="{Binding RxSection.FontSizeWpf}"
                                                       FontStyle="{Binding RxSection.FontStyleWpf}"
                                                       TextAlignment="{Binding RxSection.TextAlignmentWpf}"
                                                       Foreground="{Binding RxSection.FontColorBrush}">
                                                <Run Text="2 )" FontWeight="Bold"
                                                     Foreground="{Binding RxSection.FontColorBrush}"/>
                                                <Run Text="  Cap  " Foreground="{Binding RxSection.FontColorBrush}"/>
                                                <Run Text="Metronidazole  250mg" FontWeight="Bold"/>
                                            </TextBlock>
                                            <TextBlock Text="    N = 30"
                                                       FontFamily="{Binding RxSection.FontFamilyWpf}"
                                                       FontSize="8.5"
                                                       FontStyle="{Binding RxSection.FontStyleWpf}"
                                                       Foreground="{Binding RxSection.FontColorBrush}"
                                                       Margin="0,2,0,0"/>
                                            <TextBlock Text="سه بار در روز"
                                                       FontFamily="{Binding RxSection.FontFamilyWpf}"
                                                       FontSize="9"
                                                       FontStyle="{Binding RxSection.FontStyleWpf}"
                                                       Foreground="{Binding RxSection.FontColorBrush}"
                                                       HorizontalAlignment="Right"
                                                       FlowDirection="RightToLeft"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- ── FOOTER ─────────────────────────── -->
                            <StackPanel Grid.Row="4">
                                <!-- Footer divider -->
                                <Grid Margin="0,0,0,5"
                                      Visibility="{Binding FooterDividerVisible, Converter={StaticResource BoolToVisible}}">
                                    <Path Data="M 0,0.5 L 1,0.5" Stretch="Fill"
                                          Stroke="{Binding FooterDividerBrush}"
                                          StrokeThickness="{Binding FooterDividerThickness}"
                                          StrokeDashArray="{Binding FooterDividerDashArrayWpf}"
                                          Visibility="{Binding FooterDividerIsSingle, Converter={StaticResource BoolToVisible}}"/>
                                    <StackPanel Visibility="{Binding FooterDividerIsDouble, Converter={StaticResource BoolToVisible}}">
                                        <Path Data="M 0,0.5 L 1,0.5" Stretch="Fill"
                                              Stroke="{Binding FooterDividerBrush}" StrokeThickness="{Binding FooterDividerThickness}"/>
                                        <Path Data="M 0,0.5 L 1,0.5" Stretch="Fill" Margin="0,3,0,0"
                                              Stroke="{Binding FooterDividerBrush}" StrokeThickness="{Binding FooterDividerThickness}"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel>
                                    <TextBlock HorizontalAlignment="Right"
                                               FontFamily="{Binding Footer.FontFamilyWpf}"
                                               FontSize="{Binding Footer.FontSizeWpf}"
                                               FontWeight="{Binding Footer.FontWeightWpf}"
                                               FontStyle="{Binding Footer.FontStyleWpf}"
                                               Foreground="{Binding Footer.FontColorBrush}">
                                        <Run Text="شماره دوکتور:" FontWeight="Bold"/>
                                        <Run Text="  ☎ 0799 123 456"/>
                                    </TextBlock>
                                    <TextBlock HorizontalAlignment="Right"
                                               FontFamily="{Binding Footer.FontFamilyWpf}"
                                               FontSize="{Binding Footer.FontSizeWpf}"
                                               FontWeight="{Binding Footer.FontWeightWpf}"
                                               FontStyle="{Binding Footer.FontStyleWpf}"
                                               Foreground="{Binding Footer.FontColorBrush}"
                                               Margin="0,2,0,0">
                                        <Run Text="آدرس:" FontWeight="Bold"/>
                                        <Run Text="  مزار شریف، چهارراهی حاجی ایوب"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                        </Grid><!-- /Grid Margin -->
                    </Border><!-- /A4 page Border -->
                </Viewbox>
            </ScrollViewer>
        </DockPanel>

        </Grid><!-- /Content row -->
    </Grid>
</UserControl>
