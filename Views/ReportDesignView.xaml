<UserControl x:Class="OPDClinic.Views.ReportDesignView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OPDClinic"
             xmlns:vm="clr-namespace:OPDClinic.ViewModels"
             FlowDirection="LeftToRight">

    <UserControl.Resources>
        <!-- ── Converters ─────────────────────────────────────────────── -->
        <local:HexToBrushConverter          x:Key="HexToBrush"/>
        <local:BoolToFontWeightConverter    x:Key="BoolToFontWeight"/>
        <BooleanToVisibilityConverter       x:Key="BoolToVisible"/>

        <!-- ── Shared styles ──────────────────────────────────────────── -->
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Width"              Value="115"/>
            <Setter Property="VerticalAlignment"  Value="Center"/>
            <Setter Property="FontSize"           Value="11"/>
            <Setter Property="Foreground"         Value="{StaticResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize"       Value="10"/>
            <Setter Property="FontWeight"     Value="SemiBold"/>
            <Setter Property="Foreground"     Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin"         Value="0,10,0,4"/>
            <Setter Property="Padding"        Value="0,0,0,2"/>
        </Style>

        <Style x:Key="ColorRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <!-- ── DataTemplate for SectionStyleVm ───────────────────────── -->
        <DataTemplate x:Key="SectionTemplate" DataType="{x:Type vm:SectionStyleVm}">
            <StackPanel Margin="4,4,4,8">

                <!-- TYPOGRAPHY ─────────────────────────────────────── -->
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,10,0,4">
                    <TextBlock Text="TYPOGRAPHY" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Padding="0,0,0,2"/>
                </Border>

                <!-- Font Family -->
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Font Family" Style="{StaticResource SettingLabel}"/>
                    <ComboBox  Grid.Column="1" SelectedItem="{Binding FontFamily, Mode=TwoWay}"
                               ItemsSource="{x:Static vm:SectionStyleVm.AvailableFonts}"
                               Height="26" FontSize="11"/>
                </Grid>

                <!-- Font Size -->
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Font Size (pt)" Style="{StaticResource SettingLabel}"/>
                    <ComboBox  Grid.Column="1" SelectedItem="{Binding FontSize, Mode=TwoWay}"
                               ItemsSource="{x:Static vm:SectionStyleVm.CommonSizes}"
                               IsEditable="True" Height="26" FontSize="11"/>
                </Grid>

                <!-- Bold -->
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Bold" Style="{StaticResource SettingLabel}"/>
                    <CheckBox  Grid.Column="1" IsChecked="{Binding Bold, Mode=TwoWay}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Italic -->
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Italic" Style="{StaticResource SettingLabel}"/>
                    <CheckBox  Grid.Column="1" IsChecked="{Binding Italic, Mode=TwoWay}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Font Color -->
                <Grid Style="{StaticResource ColorRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="26"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Font Color" Style="{StaticResource SettingLabel}"/>
                    <TextBox   Grid.Column="1" Text="{Binding FontColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                               Height="26" FontSize="11" Padding="6,0"
                               VerticalContentAlignment="Center"/>
                    <Border    Grid.Column="2" Width="22" Height="22" Margin="3,0,0,0"
                               BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                               Background="{Binding FontColor, Converter={StaticResource HexToBrush}}"/>
                </Grid>

                <!-- APPEARANCE ─────────────────────────────────────── -->
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,10,0,4">
                    <TextBlock Text="APPEARANCE" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Padding="0,0,0,2"/>
                </Border>

                <!-- Background Color -->
                <Grid Style="{StaticResource ColorRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="26"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Background" Style="{StaticResource SettingLabel}"/>
                    <TextBox   Grid.Column="1" Text="{Binding BackgroundColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                               Height="26" FontSize="11" Padding="6,0"
                               VerticalContentAlignment="Center"/>
                    <Border    Grid.Column="2" Width="22" Height="22" Margin="3,0,0,0"
                               BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                               Background="{Binding BackgroundColor, Converter={StaticResource HexToBrush}}"/>
                </Grid>

                <!-- Padding -->
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Padding (pt)" Style="{StaticResource SettingLabel}"/>
                    <TextBox   Grid.Column="1" Text="{Binding Padding, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                               Height="26" FontSize="11" Padding="6,0"
                               VerticalContentAlignment="Center"/>
                </Grid>

                <!-- BORDER ─────────────────────────────────────────── -->
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,10,0,4">
                    <TextBlock Text="BORDER" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Padding="0,0,0,2"/>
                </Border>

                <!-- Show Border -->
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Show Border" Style="{StaticResource SettingLabel}"/>
                    <CheckBox  Grid.Column="1" IsChecked="{Binding ShowBorder, Mode=TwoWay}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Border Thickness -->
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Border Width" Style="{StaticResource SettingLabel}"/>
                    <TextBox   Grid.Column="1" Text="{Binding BorderThickness, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                               Height="26" FontSize="11" Padding="6,0"
                               VerticalContentAlignment="Center"/>
                </Grid>

                <!-- Border Color -->
                <Grid Style="{StaticResource ColorRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="26"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Border Color" Style="{StaticResource SettingLabel}"/>
                    <TextBox   Grid.Column="1" Text="{Binding BorderColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                               Height="26" FontSize="11" Padding="6,0"
                               VerticalContentAlignment="Center"/>
                    <Border    Grid.Column="2" Width="22" Height="22" Margin="3,0,0,0"
                               BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                               Background="{Binding BorderColor, Converter={StaticResource HexToBrush}}"/>
                </Grid>

                <!-- TITLE BAR STYLE ─────────────────────────────────── -->
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,10,0,4">
                    <TextBlock Text="TITLE BAR STYLE" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Padding="0,0,0,2"/>
                </Border>

                <!-- Title Background -->
                <Grid Style="{StaticResource ColorRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="26"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Title Background" Style="{StaticResource SettingLabel}"/>
                    <TextBox   Grid.Column="1" Text="{Binding TitleBgColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                               Height="26" FontSize="11" Padding="6,0"
                               VerticalContentAlignment="Center"/>
                    <Border    Grid.Column="2" Width="22" Height="22" Margin="3,0,0,0"
                               BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                               Background="{Binding TitleBgColor, Converter={StaticResource HexToBrush}}"/>
                </Grid>

                <!-- Title Font Color -->
                <Grid Style="{StaticResource ColorRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="26"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Title Font Color" Style="{StaticResource SettingLabel}"/>
                    <TextBox   Grid.Column="1" Text="{Binding TitleFontColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                               Height="26" FontSize="11" Padding="6,0"
                               VerticalContentAlignment="Center"/>
                    <Border    Grid.Column="2" Width="22" Height="22" Margin="3,0,0,0"
                               BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                               Background="{Binding TitleFontColor, Converter={StaticResource HexToBrush}}"/>
                </Grid>

                <!-- Title Bold -->
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Title Bold" Style="{StaticResource SettingLabel}"/>
                    <CheckBox  Grid.Column="1" IsChecked="{Binding TitleBold, Mode=TwoWay}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Reset Section button -->
                <Button Content="↺  Reset Section to Default"
                        Command="{Binding ResetCommand}"
                        HorizontalAlignment="Left"
                        Margin="0,10,0,0" Padding="10,4"
                        FontSize="11"
                        Style="{StaticResource ActionButton}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <!-- ═══ MAIN LAYOUT ═══════════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Page header -->
            <RowDefinition Height="*"/>     <!-- Content     -->
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Border Grid.Row="0" Background="White" Padding="24,16"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="Report Design &amp; Print Settings"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="360"/>  <!-- Settings panel -->
            <ColumnDefinition Width="2*" MinWidth="280"/>  <!-- Live preview   -->
        </Grid.ColumnDefinitions>

        <!-- ══ LEFT: Settings ══════════════════════════════════════════════ -->
        <DockPanel Grid.Column="0">

            <!-- Toolbar -->
            <Border DockPanel.Dock="Top"
                    Background="White" Padding="14,10"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <WrapPanel Orientation="Horizontal">

                    <!-- Global font -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Global Font:" VerticalAlignment="Center"
                                   FontSize="11" Margin="0,0,6,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <ComboBox x:Name="GlobalFontCombo"
                                  ItemsSource="{x:Static vm:SectionStyleVm.AvailableFonts}"
                                  SelectedItem="{Binding GlobalFontFamily, Mode=TwoWay}"
                                  Width="130" Height="26" FontSize="11"/>
                    </StackPanel>

                    <!-- B&W toggle -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <CheckBox IsChecked="{Binding BlackAndWhiteMode, Mode=TwoWay}"
                                  VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="B&amp;W Print Mode" VerticalAlignment="Center" FontSize="11"/>
                    </StackPanel>

                    <!-- Apply B&W palette -->
                    <Button Content="Apply B&amp;W Palette"
                            Command="{Binding ApplyBwPaletteCommand}"
                            Style="{StaticResource ActionButton}"
                            Padding="10,4" FontSize="11" Margin="0,0,8,0"/>

                    <!-- Save -->
                    <Button Content="💾  Save Settings"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Padding="12,4" FontSize="11" Margin="0,0,8,0"/>

                    <!-- Reset All -->
                    <Button Content="↺  Reset All"
                            Command="{Binding ResetAllCommand}"
                            Style="{StaticResource ActionButton}"
                            Padding="10,4" FontSize="11"/>
                </WrapPanel>
            </Border>

            <!-- Status bar -->
            <Border DockPanel.Dock="Top"
                    Visibility="{Binding StatusVisible, Converter={StaticResource BoolToVisible}}"
                    Padding="14,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#D1FAE5"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Background" Value="#FEE2E2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </Border>

            <!-- Scrollable settings -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,8,14,20">
                <StackPanel>

                    <!-- ── CLINIC NAME ────────────────────────────── -->
                    <Expander IsExpanded="False" Margin="0,6,0,0">
                        <Expander.Header>
                            <TextBlock Text="🏥  Clinic Name  (printed above physician name)"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="12">
                            <ContentControl DataContext="{Binding ClinicName}"
                                            ContentTemplate="{StaticResource SectionTemplate}"
                                            Content="{Binding}"/>
                        </Border>
                    </Expander>

                    <!-- ── TAGLINE ────────────────────────────────── -->
                    <Expander IsExpanded="False" Margin="0,6,0,0">
                        <Expander.Header>
                            <TextBlock Text="✍  Tagline / Motto  (printed below logo)"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="12">
                            <ContentControl DataContext="{Binding Tagline}"
                                            ContentTemplate="{StaticResource SectionTemplate}"
                                            Content="{Binding}"/>
                        </Border>
                    </Expander>

                    <!-- ── HEADER ──────────────────────────────────── -->
                    <Expander IsExpanded="True" Margin="0,6,0,0">
                        <Expander.Header>
                            <TextBlock Text="📋  Header Section  (Physician Name / Speciality)"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="12">
                            <ContentControl DataContext="{Binding Header}"
                                            ContentTemplate="{StaticResource SectionTemplate}"
                                            Content="{Binding}"/>
                        </Border>
                    </Expander>

                    <!-- ── PATIENT BAR ────────────────────────────── -->
                    <Expander IsExpanded="False" Margin="0,6,0,0">
                        <Expander.Header>
                            <TextBlock Text="👤  Patient Information Bar"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="12">
                            <ContentControl DataContext="{Binding PatientBar}"
                                            ContentTemplate="{StaticResource SectionTemplate}"
                                            Content="{Binding}"/>
                        </Border>
                    </Expander>

                    <!-- ── VITAL SIGNS ────────────────────────────── -->
                    <Expander IsExpanded="False" Margin="0,6,0,0">
                        <Expander.Header>
                            <TextBlock Text="🩺  Vital Signs Box"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="12">
                            <ContentControl DataContext="{Binding VitalSigns}"
                                            ContentTemplate="{StaticResource SectionTemplate}"
                                            Content="{Binding}"/>
                        </Border>
                    </Expander>

                    <!-- ── CLINICAL FINDINGS ──────────────────────── -->
                    <Expander IsExpanded="False" Margin="0,6,0,0">
                        <Expander.Header>
                            <TextBlock Text="📝  Clinical Findings Box"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="12">
                            <ContentControl DataContext="{Binding ClinicalFindings}"
                                            ContentTemplate="{StaticResource SectionTemplate}"
                                            Content="{Binding}"/>
                        </Border>
                    </Expander>

                    <!-- ── DIAGNOSIS ──────────────────────────────── -->
                    <Expander IsExpanded="False" Margin="0,6,0,0">
                        <Expander.Header>
                            <TextBlock Text="🔬  Diagnosis Box"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="12">
                            <ContentControl DataContext="{Binding Diagnosis}"
                                            ContentTemplate="{StaticResource SectionTemplate}"
                                            Content="{Binding}"/>
                        </Border>
                    </Expander>

                    <!-- ── LAB TESTS ──────────────────────────────── -->
                    <Expander IsExpanded="False" Margin="0,6,0,0">
                        <Expander.Header>
                            <TextBlock Text="🧪  Lab Tests Box"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="12">
                            <ContentControl DataContext="{Binding LabTests}"
                                            ContentTemplate="{StaticResource SectionTemplate}"
                                            Content="{Binding}"/>
                        </Border>
                    </Expander>

                    <!-- ── Rx SECTION ─────────────────────────────── -->
                    <Expander IsExpanded="False" Margin="0,6,0,0">
                        <Expander.Header>
                            <TextBlock Text="💊  Prescription (Rx) Section"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="12">
                            <ContentControl DataContext="{Binding RxSection}"
                                            ContentTemplate="{StaticResource SectionTemplate}"
                                            Content="{Binding}"/>
                        </Border>
                    </Expander>

                    <!-- ── FOOTER ─────────────────────────────────── -->
                    <Expander IsExpanded="False" Margin="0,6,0,0">
                        <Expander.Header>
                            <TextBlock Text="📞  Footer Section  (Contact / Address)"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="12">
                            <ContentControl DataContext="{Binding Footer}"
                                            ContentTemplate="{StaticResource SectionTemplate}"
                                            Content="{Binding}"/>
                        </Border>
                    </Expander>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- ── Vertical divider ──────────────────────────────────────────── -->
        <Border Grid.Column="0" HorizontalAlignment="Right" Width="1"
                Background="{StaticResource BorderBrush}"/>

        <!-- ══ RIGHT: Live Preview ═════════════════════════════════════════ -->
        <DockPanel Grid.Column="1" Background="#F3F4F6">

            <!-- Preview header -->
            <Border DockPanel.Dock="Top" Background="White" Padding="12,8"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <TextBlock Text="Live Preview" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </Border>

            <!-- A4 page preview (Viewbox scales to fit) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                          Padding="16">
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                    <!-- 595 × 842 ≈ A4 proportions in WPF units -->
                    <Border Width="595" Height="842" Background="White"
                            BorderBrush="#CCCCCC" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="4" BlurRadius="8"
                                              Color="#AAAAAA" Opacity="0.4"/>
                        </Border.Effect>

                        <Grid Margin="28,22,28,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>  <!-- Header     -->
                                <RowDefinition Height="6"/>     <!-- Divider gap-->
                                <RowDefinition Height="Auto"/>  <!-- Patient bar-->
                                <RowDefinition Height="*"/>     <!-- Body       -->
                                <RowDefinition Height="Auto"/>  <!-- Footer     -->
                            </Grid.RowDefinitions>

                            <!-- ── HEADER ──────────────────────────────── -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: EN name -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Dr. Ahmad Karimi"
                                               FontFamily="{Binding Header.FontFamilyWpf}"
                                               FontSize="{Binding Header.FontSizeWpf}"
                                               FontWeight="{Binding Header.FontWeightWpf}"
                                               Foreground="{Binding Header.FontColorBrush}"/>
                                    <TextBlock Text="Gynecologist &amp; Obstetrician"
                                               FontFamily="{Binding Header.FontFamilyWpf}"
                                               FontSize="10" Margin="0,2,0,0"
                                               Foreground="{Binding Header.FontColorBrush}"/>
                                </StackPanel>

                                <!-- Centre: logo circle -->
                                <Border Grid.Column="1" Width="54" Height="54"
                                        CornerRadius="27"
                                        HorizontalAlignment="Center"
                                        BorderBrush="{Binding Header.FontColorBrush}"
                                        BorderThickness="1.5"
                                        Background="{Binding VitalSigns.TitleBgBrush}">
                                    <TextBlock Text="AK" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{Binding Header.FontColorBrush}"/>
                                </Border>

                                <!-- Right: Dari name (RTL) -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right"
                                            FlowDirection="RightToLeft">
                                    <TextBlock Text="دکتر احمد کریمی"
                                               FontFamily="{Binding Header.FontFamilyWpf}"
                                               FontSize="{Binding Header.FontSizeWpf}"
                                               FontWeight="{Binding Header.FontWeightWpf}"
                                               Foreground="{Binding Header.FontColorBrush}"/>
                                    <TextBlock Text="متخصص زنان و مامایی"
                                               FontFamily="{Binding Header.FontFamilyWpf}"
                                               FontSize="10" Margin="0,2,0,0"
                                               Foreground="{Binding Header.FontColorBrush}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Divider line -->
                            <Border Grid.Row="1"
                                    BorderBrush="{Binding Header.FontColorBrush}"
                                    BorderThickness="0,2,0,0" Margin="0,4"/>

                            <!-- ── PATIENT BAR ─────────────────────── -->
                            <Border Grid.Row="2"
                                    Background="{Binding PatientBar.BgBrush}"
                                    BorderBrush="{Binding PatientBar.BorderColorBrush}"
                                    BorderThickness="{Binding PatientBar.BorderThicknessWpf}"
                                    Padding="8,6">
                                <TextBlock FontFamily="{Binding PatientBar.FontFamilyWpf}"
                                           FontSize="{Binding PatientBar.FontSizeWpf}"
                                           Foreground="{Binding PatientBar.FontColorBrush}">
                                    <Run Text="نام مریض:" FontWeight="Bold"/>
                                    <Run Text="   زینب محمدی    "/>
                                    <Run Text="سن:" FontWeight="Bold"/>
                                    <Run Text="  28   "/>
                                    <Run Text="تاریخ:" FontWeight="Bold"/>
                                    <Run Text="  ۱۴۰۳/۰۱/۱۵"/>
                                </TextBlock>
                            </Border>

                            <!-- ── BODY ───────────────────────────── -->
                            <Grid Grid.Row="3" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="2.6*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left column: boxes -->
                                <StackPanel Grid.Column="0">

                                    <!-- Vital Signs -->
                                    <Border BorderBrush="{Binding VitalSigns.BorderColorBrush}"
                                            BorderThickness="{Binding VitalSigns.BorderThicknessWpf}"
                                            Background="{Binding VitalSigns.BgBrush}"
                                            Margin="0,0,0,6">
                                        <StackPanel>
                                            <Border Background="{Binding VitalSigns.TitleBgBrush}"
                                                    Padding="5,3">
                                                <TextBlock Text="Vital Signs"
                                                           FontFamily="{Binding VitalSigns.FontFamilyWpf}"
                                                           FontSize="8.5" FontWeight="{Binding VitalSigns.TitleFontWeightWpf}"
                                                           Foreground="{Binding VitalSigns.TitleFontBrush}"/>
                                            </Border>
                                            <StackPanel Margin="6,4">
                                                <TextBlock FontFamily="{Binding VitalSigns.FontFamilyWpf}"
                                                           FontSize="{Binding VitalSigns.FontSizeWpf}"
                                                           Foreground="{Binding VitalSigns.FontColorBrush}">
                                                    <Run Text="BP:" FontWeight="Bold"/><Run Text="  120/80    "/>
                                                    <Run Text="PR:" FontWeight="Bold"/><Run Text="  76"/>
                                                </TextBlock>
                                                <TextBlock FontFamily="{Binding VitalSigns.FontFamilyWpf}"
                                                           FontSize="{Binding VitalSigns.FontSizeWpf}"
                                                           Foreground="{Binding VitalSigns.FontColorBrush}"
                                                           Margin="0,3,0,0">
                                                    <Run Text="BT:" FontWeight="Bold"/><Run Text="  37.1    "/>
                                                    <Run Text="BW:" FontWeight="Bold"/><Run Text="  62 kg"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Clinical Findings -->
                                    <Border BorderBrush="{Binding ClinicalFindings.BorderColorBrush}"
                                            BorderThickness="{Binding ClinicalFindings.BorderThicknessWpf}"
                                            Background="{Binding ClinicalFindings.BgBrush}"
                                            Margin="0,0,0,6">
                                        <StackPanel>
                                            <Border Background="{Binding ClinicalFindings.TitleBgBrush}" Padding="5,3">
                                                <TextBlock Text="Clinical Findings"
                                                           FontFamily="{Binding ClinicalFindings.FontFamilyWpf}"
                                                           FontSize="8.5" FontWeight="{Binding ClinicalFindings.TitleFontWeightWpf}"
                                                           Foreground="{Binding ClinicalFindings.TitleFontBrush}"/>
                                            </Border>
                                            <TextBlock Text="Lower abdominal pain, nausea."
                                                       FontFamily="{Binding ClinicalFindings.FontFamilyWpf}"
                                                       FontSize="{Binding ClinicalFindings.FontSizeWpf}"
                                                       Foreground="{Binding ClinicalFindings.FontColorBrush}"
                                                       Margin="6,4" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Diagnosis -->
                                    <Border BorderBrush="{Binding Diagnosis.BorderColorBrush}"
                                            BorderThickness="{Binding Diagnosis.BorderThicknessWpf}"
                                            Background="{Binding Diagnosis.BgBrush}"
                                            Margin="0,0,0,6">
                                        <StackPanel>
                                            <Border Background="{Binding Diagnosis.TitleBgBrush}" Padding="5,3">
                                                <TextBlock Text="Diagnosis"
                                                           FontFamily="{Binding Diagnosis.FontFamilyWpf}"
                                                           FontSize="8.5" FontWeight="{Binding Diagnosis.TitleFontWeightWpf}"
                                                           Foreground="{Binding Diagnosis.TitleFontBrush}"/>
                                            </Border>
                                            <TextBlock Text="Pelvic Inflammatory Disease"
                                                       FontFamily="{Binding Diagnosis.FontFamilyWpf}"
                                                       FontSize="{Binding Diagnosis.FontSizeWpf}"
                                                       Foreground="{Binding Diagnosis.FontColorBrush}"
                                                       Margin="6,4" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Lab Tests -->
                                    <Border BorderBrush="{Binding LabTests.BorderColorBrush}"
                                            BorderThickness="{Binding LabTests.BorderThicknessWpf}"
                                            Background="{Binding LabTests.BgBrush}">
                                        <StackPanel>
                                            <Border Background="{Binding LabTests.TitleBgBrush}" Padding="5,3">
                                                <TextBlock Text="Lab Tests"
                                                           FontFamily="{Binding LabTests.FontFamilyWpf}"
                                                           FontSize="8.5" FontWeight="{Binding LabTests.TitleFontWeightWpf}"
                                                           Foreground="{Binding LabTests.TitleFontBrush}"/>
                                            </Border>
                                            <TextBlock Text="CBC   •   CRP   •   Urine R/E"
                                                       FontFamily="{Binding LabTests.FontFamilyWpf}"
                                                       FontSize="{Binding LabTests.FontSizeWpf}"
                                                       Foreground="{Binding LabTests.FontColorBrush}"
                                                       Margin="6,4" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Right column: Rx -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Rx" FontSize="22" FontStyle="Italic"
                                               FontFamily="{Binding RxSection.FontFamilyWpf}"
                                               FontWeight="{Binding RxSection.FontWeightWpf}"
                                               Foreground="{Binding RxSection.FontColorBrush}"
                                               Margin="0,0,0,6"/>

                                    <!-- Rx line 1 -->
                                    <Border BorderBrush="{Binding RxSection.BorderColorBrush}"
                                            BorderThickness="0,0,0,0.5"
                                            Padding="4,5">
                                        <StackPanel>
                                            <TextBlock FontFamily="{Binding RxSection.FontFamilyWpf}"
                                                       FontSize="{Binding RxSection.FontSizeWpf}"
                                                       Foreground="{Binding RxSection.FontColorBrush}">
                                                <Run Text="1 )" FontWeight="Bold"
                                                     Foreground="{Binding RxSection.FontColorBrush}"/>
                                                <Run Text="  Tab  " Foreground="{Binding VitalSigns.FontColorBrush}"/>
                                                <Run Text="Amoxicillin  500mg" FontWeight="Bold"/>
                                            </TextBlock>
                                            <TextBlock Text="    N = 21"
                                                       FontFamily="{Binding RxSection.FontFamilyWpf}"
                                                       FontSize="8.5"
                                                       Foreground="{Binding VitalSigns.FontColorBrush}"
                                                       Margin="0,2,0,0"/>
                                            <TextBlock Text="دو بار در روز بعد از غذا"
                                                       FontFamily="{Binding RxSection.FontFamilyWpf}"
                                                       FontSize="9"
                                                       Foreground="{Binding RxSection.FontColorBrush}"
                                                       HorizontalAlignment="Right"
                                                       FlowDirection="RightToLeft"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Rx line 2 -->
                                    <Border BorderBrush="{Binding RxSection.BorderColorBrush}"
                                            BorderThickness="0,0,0,0.5"
                                            Padding="4,5">
                                        <StackPanel>
                                            <TextBlock FontFamily="{Binding RxSection.FontFamilyWpf}"
                                                       FontSize="{Binding RxSection.FontSizeWpf}"
                                                       Foreground="{Binding RxSection.FontColorBrush}">
                                                <Run Text="2 )" FontWeight="Bold"
                                                     Foreground="{Binding RxSection.FontColorBrush}"/>
                                                <Run Text="  Cap  " Foreground="{Binding VitalSigns.FontColorBrush}"/>
                                                <Run Text="Metronidazole  250mg" FontWeight="Bold"/>
                                            </TextBlock>
                                            <TextBlock Text="    N = 30"
                                                       FontFamily="{Binding RxSection.FontFamilyWpf}"
                                                       FontSize="8.5"
                                                       Foreground="{Binding VitalSigns.FontColorBrush}"
                                                       Margin="0,2,0,0"/>
                                            <TextBlock Text="سه بار در روز"
                                                       FontFamily="{Binding RxSection.FontFamilyWpf}"
                                                       FontSize="9"
                                                       Foreground="{Binding RxSection.FontColorBrush}"
                                                       HorizontalAlignment="Right"
                                                       FlowDirection="RightToLeft"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- ── FOOTER ─────────────────────────── -->
                            <Border Grid.Row="4"
                                    BorderBrush="{Binding Footer.BorderColorBrush}"
                                    BorderThickness="0,1.5,0,0"
                                    Padding="0,5,0,0">
                                <StackPanel>
                                    <TextBlock HorizontalAlignment="Right"
                                               FontFamily="{Binding Footer.FontFamilyWpf}"
                                               FontSize="{Binding Footer.FontSizeWpf}"
                                               Foreground="{Binding Footer.FontColorBrush}">
                                        <Run Text="شماره دوکتور:" FontWeight="Bold"/>
                                        <Run Text="  ☎ 0799 123 456"/>
                                    </TextBlock>
                                    <TextBlock HorizontalAlignment="Right"
                                               FontFamily="{Binding Footer.FontFamilyWpf}"
                                               FontSize="{Binding Footer.FontSizeWpf}"
                                               Foreground="{Binding Footer.FontColorBrush}"
                                               Margin="0,2,0,0">
                                        <Run Text="آدرس:" FontWeight="Bold"/>
                                        <Run Text="  مزار شریف، چهارراهی حاجی ایوب"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                        </Grid><!-- /Grid Margin -->
                    </Border><!-- /A4 page Border -->
                </Viewbox>
            </ScrollViewer>
        </DockPanel>

        </Grid><!-- /Content row -->
    </Grid>
</UserControl>
