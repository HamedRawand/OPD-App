<UserControl x:Class="OPDClinic.Views.PatientListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OPDClinic"
             PreviewKeyDown="UserControl_PreviewKeyDown">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisible"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource ContentBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header bar -->
        <Border Grid.Row="0" Background="White" Padding="24,16"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Text="{DynamicResource PatList.Title}"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" Margin="0,0,16,0"
                               Text="{Binding TotalCount, StringFormat='{}({0} patients)'}"/>
                    <Button Content="{DynamicResource PatList.NewVisit}"
                            Style="{StaticResource PrimaryButton}"
                            ToolTip="New patient  (Ctrl+N)"
                            Click="NewPatient_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Filter bar -->
        <Border Grid.Row="1" Background="#EEF2F7" Padding="24,10"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <WrapPanel VerticalAlignment="Center">
                <Border CornerRadius="5" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" Background="White" Margin="0,0,10,0">
                    <DockPanel Width="220" Height="34">
                        <TextBlock DockPanel.Dock="Left" Text="🔍" VerticalAlignment="Center"
                                   Margin="10,0,6,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox x:Name="SearchBox"
                                 BorderThickness="0" FontSize="13" VerticalContentAlignment="Center"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search patients  (Ctrl+F)"
                                 Background="Transparent" FlowDirection="LeftToRight"/>
                    </DockPanel>
                </Border>
                <ComboBox ItemsSource="{Binding Physicians}"
                          SelectedItem="{Binding SelectedPhysician}"
                          DisplayMemberPath="NameEng"
                          Style="{StaticResource FormComboBox}"
                          Width="190" Margin="0,0,10,0" Height="34"
                          Visibility="{Binding ShowPhysicianFilter, Converter={StaticResource BoolToVisible}}"/>
                <DatePicker SelectedDate="{Binding FilterDate}"
                            Width="140" Height="34" Margin="0,0,10,0" FontSize="13"/>
                <Button Content="{DynamicResource PatList.Clear}"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ClearFiltersCommand}"
                        Height="34" Padding="12,0"/>
                <TextBlock Text="{Binding TruncationNotice}"
                           Foreground="#744210" FontSize="11"
                           VerticalAlignment="Center" Margin="12,0,0,0"
                           Visibility="{Binding TruncationNotice,
                                        Converter={x:Static local:Converters.NullToCollapsed}}"/>
            </WrapPanel>
        </Border>

        <!-- DataGrid + loading/empty overlays -->
        <Grid Grid.Row="2">
            <DataGrid x:Name="PatientsGrid"
                      ItemsSource="{Binding Patients}"
                      Style="{StaticResource AppDataGrid}"
                      Margin="16" SelectionChanged="PatientsGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource PatList.Col.PatientCode}" Width="90"
                        Binding="{Binding PatientCode}"/>
                    <!-- Name + optional source-clinic badge for merged records -->
                    <DataGridTemplateColumn Header="{DynamicResource PatList.Col.Name}" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
                                    <TextBlock Text="{Binding PatientName}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Border Background="#EFF6FF" CornerRadius="3"
                                            Padding="5,1" Margin="6,0,0,0"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsImported}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding SourceClinic}"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#1565C0"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{DynamicResource PatList.Col.Sex}" Width="65"
                        Binding="{Binding Sex}"/>
                    <DataGridTextColumn Header="{DynamicResource PatList.Col.Phone}" Width="110"
                        Binding="{Binding PhoneNumber}"/>
                    <DataGridTextColumn Header="{DynamicResource PatList.Col.Visits}" Width="75"
                        Binding="{Binding VisitCountText}"/>
                    <DataGridTextColumn Header="{DynamicResource PatList.Col.LastVisit}" Width="110"
                        Binding="{Binding LastVisitText}"/>
                    <DataGridTextColumn Header="{DynamicResource PatList.Col.Physician}" Width="150"
                        Binding="{Binding LastPhysicianName}"/>
                    <DataGridTextColumn Header="{DynamicResource PatList.Col.Diagnosis}" Width="*"
                        Binding="{Binding LastDiagnosis}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="" Width="100" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{DynamicResource PatList.ViewHistory}"
                                        Style="{StaticResource ActionButton}"
                                        Tag="{Binding}" Click="ViewPatient_Click"
                                        HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Loading overlay -->
            <Border Background="#80FFFFFF"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisible}}"
                    Panel.ZIndex="10">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Loading…" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding TotalCount, Converter={x:Static local:Converters.ZeroToVisible}}">
                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="52"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource BorderBrush}"/>
                <TextBlock Text="No patients found"
                           FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,12,0,4"/>
                <TextBlock Text="Try adjusting the filters or click '+ New Patient' to register a patient."
                           FontSize="12" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
