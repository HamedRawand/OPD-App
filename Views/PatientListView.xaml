<UserControl x:Class="OPDClinic.Views.PatientListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OPDClinic">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisible"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource ContentBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header bar -->
        <Border Grid.Row="0" Background="White" Padding="24,16"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Text="{DynamicResource PatList.Title}"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" Margin="0,0,16,0"
                               Text="{Binding TotalCount, StringFormat='{}({0} records)'}"/>
                    <Button Content="{DynamicResource PatList.NewVisit}"
                            Style="{StaticResource PrimaryButton}"
                            Click="NewVisit_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Filter bar -->
        <Border Grid.Row="1" Background="#EEF2F7" Padding="24,10"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <WrapPanel VerticalAlignment="Center">
                <Border CornerRadius="5" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" Background="White" Margin="0,0,10,0">
                    <DockPanel Width="220" Height="34">
                        <TextBlock DockPanel.Dock="Left" Text="🔍" VerticalAlignment="Center"
                                   Margin="10,0,6,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox BorderThickness="0" FontSize="13" VerticalContentAlignment="Center"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" FlowDirection="LeftToRight"/>
                    </DockPanel>
                </Border>
                <ComboBox ItemsSource="{Binding Physicians}"
                          SelectedItem="{Binding SelectedPhysician}"
                          DisplayMemberPath="NameEng"
                          Style="{StaticResource FormComboBox}"
                          Width="190" Margin="0,0,10,0" Height="34"/>
                <DatePicker SelectedDate="{Binding FilterDate}"
                            Width="140" Height="34" Margin="0,0,10,0" FontSize="13"/>
                <Button Content="{DynamicResource PatList.Clear}"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ClearFiltersCommand}"
                        Height="34" Padding="12,0"/>
                <TextBlock Text="{Binding TruncationNotice}"
                           Foreground="#744210" FontSize="11"
                           VerticalAlignment="Center" Margin="12,0,0,0"
                           Visibility="{Binding TruncationNotice,
                                        Converter={x:Static local:Converters.NullToCollapsed}}"/>
            </WrapPanel>
        </Border>

        <!-- DataGrid + empty state -->
        <Grid Grid.Row="2">
        <DataGrid x:Name="PatientsGrid"
                  ItemsSource="{Binding Patients}"
                  Style="{StaticResource AppDataGrid}"
                  Margin="16" SelectionChanged="PatientsGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource PatList.Col.Date}" Width="100"
                    Binding="{Binding OpdDate, StringFormat=\{0:yyyy-MM-dd\}}"/>
                <DataGridTextColumn Header="{DynamicResource PatList.Col.Shamsi}" Width="110"
                    Binding="{Binding HijriDate}"/>
                <DataGridTextColumn Header="{DynamicResource PatList.Col.Name}" Width="150"
                    Binding="{Binding PatientName}"/>
                <DataGridTextColumn Header="{DynamicResource PatList.Col.Age}" Width="55"
                    Binding="{Binding Age}"/>
                <DataGridTextColumn Header="{DynamicResource PatList.Col.Sex}" Width="65"
                    Binding="{Binding Sex}"/>
                <DataGridTextColumn Header="{DynamicResource PatList.Col.No}" Width="65"
                    Binding="{Binding PatientNumber}"/>
                <DataGridTextColumn Header="{DynamicResource PatList.Col.BP}" Width="75"
                    Binding="{Binding BP}"/>
                <DataGridTextColumn Header="{DynamicResource PatList.Col.Physician}" Width="160"
                    Binding="{Binding Physician.NameEng}"/>
                <DataGridTextColumn Header="{DynamicResource PatList.Col.Diagnosis}" Width="*"
                    Binding="{Binding Diagnosis}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="" Width="140" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="{DynamicResource Common.Edit}"
                                        Style="{StaticResource ActionButton}"
                                        Tag="{Binding}" Click="EditVisit_Click"
                                        Margin="0,0,4,0"/>
                                <Button Content="{DynamicResource Common.Print}"
                                        Style="{StaticResource ActionButton}"
                                        Tag="{Binding}" Click="PrintVisit_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Loading overlay -->
        <Border Background="#80FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisible}}"
                Panel.ZIndex="10">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Loading…" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Empty state — shown when no patients match the current filters -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding TotalCount, Converter={x:Static local:Converters.ZeroToVisible}}">
            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="52"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource BorderBrush}"/>
            <TextBlock Text="No patients found"
                       FontSize="15" FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,12,0,4"/>
            <TextBlock Text="Try adjusting the filters or click '+ New Visit' to add a patient."
                       FontSize="12" HorizontalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>
        </Grid>

    </Grid>
</UserControl>
