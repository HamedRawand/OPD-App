<Window x:Class="OPDClinic.Views.PrescriptionLineEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource RxLine.Edit.Title}"
        Height="480" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FlowDirection="{DynamicResource App.FlowDirection}"
        Background="{StaticResource ContentBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="24,14">
            <TextBlock Text="{DynamicResource RxLine.Edit.Header}"
                       Foreground="White" FontSize="16" FontWeight="Bold"/>
        </Border>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel>

                <!-- Form (parent selector) -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="{DynamicResource Rx.Form}" Style="{StaticResource FormLabel}"/>
                    <ComboBox x:Name="FormBox"
                              DisplayMemberPath="FormName"
                              Style="{StaticResource FormComboBox}"
                              SelectionChanged="FormBox_SelectionChanged"/>
                </StackPanel>

                <!-- Medicine Name (filtered by Form) -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="{DynamicResource Rx.Medicine}" Style="{StaticResource FormLabel}"/>
                    <ComboBox x:Name="MedicineBox"
                              IsEditable="True"
                              StaysOpenOnEdit="True"
                              IsTextSearchEnabled="False"
                              DisplayMemberPath="MedicineName"
                              Style="{StaticResource FormComboBox}"/>
                </StackPanel>

                <!-- Strength + Qty -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Rx.Strength}" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="StrengthBox"
                                 Style="{StaticResource FormTextBox}"
                                 FlowDirection="LeftToRight"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource Rx.Qty}" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="QtyBox"
                                 Style="{StaticResource FormTextBox}"
                                 FlowDirection="LeftToRight"/>
                    </StackPanel>
                </Grid>

                <!-- Dosage (filtered by Form Category) -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="{DynamicResource Rx.Dosage}" Style="{StaticResource FormLabel}"/>
                    <ComboBox x:Name="DosageBox"
                              DisplayMemberPath="DosageText"
                              Style="{StaticResource FormComboBox}"/>
                </StackPanel>

                <!-- Note (filtered by Form Category — full width) -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="{DynamicResource Rx.Note}" Style="{StaticResource FormLabel}"/>
                    <ComboBox x:Name="NoteBox"
                              DisplayMemberPath="Notes"
                              Style="{StaticResource FormComboBox}"/>
                </StackPanel>

                <!-- Error -->
                <Border x:Name="ErrorBorder" Background="#FEE2E2" CornerRadius="5"
                        Padding="12,8" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Foreground="#B91C1C" FontSize="12"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" Padding="24,14"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="{DynamicResource Common.Save}"
                        Style="{StaticResource PrimaryButton}"
                        Click="Save_Click" MinWidth="120"/>
                <Button DockPanel.Dock="Right"
                        Content="{DynamicResource Common.Cancel}"
                        Style="{StaticResource SecondaryButton}"
                        IsCancel="True"
                        Click="Cancel_Click"
                        Margin="0,0,10,0" MinWidth="100"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
