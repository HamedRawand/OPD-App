<UserControl x:Class="OPDClinic.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Background="{StaticResource ContentBgBrush}">

    <UserControl.Resources>
        <!-- Stat card accent brushes -->
        <SolidColorBrush x:Key="Accent.Blue"   Color="#1565C0"/>
        <SolidColorBrush x:Key="Accent.Green"  Color="#16A34A"/>
        <SolidColorBrush x:Key="Accent.Orange" Color="#EA580C"/>
        <SolidColorBrush x:Key="Accent.Purple" Color="#7C3AED"/>

        <!-- Stat card light backgrounds -->
        <SolidColorBrush x:Key="Accent.Blue.Bg"   Color="#EFF6FF"/>
        <SolidColorBrush x:Key="Accent.Green.Bg"  Color="#F0FDF4"/>
        <SolidColorBrush x:Key="Accent.Orange.Bg" Color="#FFF7ED"/>
        <SolidColorBrush x:Key="Accent.Purple.Bg" Color="#F5F3FF"/>

        <!-- Shared stat-card number style -->
        <Style x:Key="StatNumber" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="34"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin"     Value="0,4,0,2"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,32">

            <!-- ── Page header ──────────────────────────────────────────── -->
            <DockPanel Margin="0,0,0,20" FlowDirection="LeftToRight">
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="TodayGregorianText"
                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Right"/>
                    <TextBlock x:Name="TodayShamsiLabel"
                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Right" FlowDirection="RightToLeft"/>
                </StackPanel>

                <Button DockPanel.Dock="Right"
                        Content="{DynamicResource Common.Refresh}"
                        Style="{StaticResource SecondaryButton}"
                        Click="Refresh_Click"
                        Margin="0,0,16,0" VerticalAlignment="Center"/>

                <StackPanel>
                    <TextBlock Text="{DynamicResource Dashboard.Title}"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource Dashboard.Subtitle}"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- ── Status message (backup result, etc.) ─────────────────── -->
            <Border x:Name="StatusBorder" CornerRadius="6" Padding="14,10"
                    Margin="0,0,0,16" Visibility="Collapsed">
                <TextBlock x:Name="StatusText" FontSize="13" FontWeight="SemiBold"/>
            </Border>

            <!-- ── Row 1 — Stat cards ────────────────────────────────────── -->
            <UniformGrid Columns="4" Margin="0,0,0,16">

                <!-- Total Patients -->
                <Border Style="{StaticResource Card}" Margin="0,0,10,0"
                        Background="{StaticResource Accent.Blue.Bg}"
                        BorderBrush="#BFDBFE" BorderThickness="1">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Dashboard.TotalPatients}"
                                       Style="{StaticResource StatLabel}"
                                       Foreground="{StaticResource Accent.Blue}"/>
                            <TextBlock x:Name="TotalPatientsText"
                                       Style="{StaticResource StatNumber}"
                                       Foreground="{StaticResource Accent.Blue}"/>
                            <TextBlock Text="{DynamicResource Dashboard.AllTime}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="40" Opacity="0.15"
                                   Foreground="{StaticResource Accent.Blue}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,0,4,0" FlowDirection="LeftToRight"/>
                    </Grid>
                </Border>

                <!-- Today's Patients -->
                <Border Style="{StaticResource Card}" Margin="0,0,10,0"
                        Background="{StaticResource Accent.Green.Bg}"
                        BorderBrush="#BBF7D0" BorderThickness="1">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Dashboard.TodayPatients}"
                                       Style="{StaticResource StatLabel}"
                                       Foreground="{StaticResource Accent.Green}"/>
                            <TextBlock x:Name="TodayPatientsText"
                                       Style="{StaticResource StatNumber}"
                                       Foreground="{StaticResource Accent.Green}"/>
                            <TextBlock Text="{DynamicResource Dashboard.TodayVisits}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="40" Opacity="0.15"
                                   Foreground="{StaticResource Accent.Green}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,0,4,0" FlowDirection="LeftToRight"/>
                    </Grid>
                </Border>

                <!-- Medicines -->
                <Border Style="{StaticResource Card}" Margin="0,0,10,0"
                        Background="{StaticResource Accent.Orange.Bg}"
                        BorderBrush="#FED7AA" BorderThickness="1">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Dashboard.TotalMedicines}"
                                       Style="{StaticResource StatLabel}"
                                       Foreground="{StaticResource Accent.Orange}"/>
                            <TextBlock x:Name="TotalMedicinesText"
                                       Style="{StaticResource StatNumber}"
                                       Foreground="{StaticResource Accent.Orange}"/>
                            <TextBlock Text="{DynamicResource Dashboard.InCatalog}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="40" Opacity="0.15"
                                   Foreground="{StaticResource Accent.Orange}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,0,4,0" FlowDirection="LeftToRight"/>
                    </Grid>
                </Border>

                <!-- Physicians -->
                <Border Style="{StaticResource Card}" Margin="0"
                        Background="{StaticResource Accent.Purple.Bg}"
                        BorderBrush="#DDD6FE" BorderThickness="1">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Dashboard.TotalPhysicians}"
                                       Style="{StaticResource StatLabel}"
                                       Foreground="{StaticResource Accent.Purple}"/>
                            <TextBlock x:Name="TotalPhysiciansText"
                                       Style="{StaticResource StatNumber}"
                                       Foreground="{StaticResource Accent.Purple}"/>
                            <TextBlock Text="{DynamicResource Dashboard.Registered}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="40" Opacity="0.15"
                                   Foreground="{StaticResource Accent.Purple}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,0,4,0" FlowDirection="LeftToRight"/>
                    </Grid>
                </Border>

            </UniformGrid>

            <!-- ── Row 2 — Info cards + Quick Actions ───────────────────── -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Last Backup card -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <DockPanel FlowDirection="LeftToRight">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{DynamicResource Dashboard.LastBackup}"
                                   Style="{StaticResource SectionHeader}"
                                   Margin="0,0,0,8"/>
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="32" Foreground="{StaticResource PrimaryBrush}"
                                       Margin="0,0,16,0"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="LastBackupDateText"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="LastBackupSizeText"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- DB Size card -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel FlowDirection="LeftToRight">
                        <TextBlock Text="{DynamicResource Dashboard.DbSize}"
                                   Style="{StaticResource SectionHeader}"
                                   Margin="0,0,0,8"/>
                        <DockPanel>
                            <TextBlock Text="&#xEDA3;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="28" Foreground="{StaticResource PrimaryBrush}"
                                       Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DbSizeText"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Quick Actions card -->
                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel FlowDirection="LeftToRight">
                        <TextBlock Text="{DynamicResource Dashboard.QuickActions}"
                                   Style="{StaticResource SectionHeader}"
                                   Margin="0,0,0,10"/>
                        <Button Content="{DynamicResource Dashboard.Btn.NewVisit}"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,8"
                                Click="NewVisit_Click"/>
                        <Button Content="{DynamicResource Dashboard.Btn.Backup}"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Stretch"
                                Click="CreateBackup_Click"/>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- ── Row 3 — Recent Visits ─────────────────────────────────── -->
            <Border Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Dashboard.RecentVisits}"
                               Style="{StaticResource SectionHeader}"
                               Margin="20,16,20,0"/>

                    <DataGrid x:Name="RecentGrid"
                              Style="{StaticResource AppDataGrid}"
                              BorderThickness="0,1,0,0"
                              Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource PatList.Col.Date}"
                                                Binding="{Binding VisitDate}"
                                                Width="110"/>
                            <DataGridTextColumn Header="{DynamicResource PatList.Col.Shamsi}"
                                                Binding="{Binding ShamsiDate}"
                                                Width="120"/>
                            <DataGridTextColumn Header="{DynamicResource PatList.Col.Name}"
                                                Binding="{Binding PatientName}"
                                                Width="*"/>
                            <DataGridTextColumn Header="{DynamicResource PatList.Col.Physician}"
                                                Binding="{Binding Physician}"
                                                Width="150"/>
                            <DataGridTextColumn Header="{DynamicResource PatList.Col.Diagnosis}"
                                                Binding="{Binding Diagnosis}"
                                                Width="2*"/>
                            <DataGridTemplateColumn Header="" Width="60" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{DynamicResource Common.Open}"
                                                Style="{StaticResource ActionButton}"
                                                ToolTip="Open patient record"
                                                Tag="{Binding}"
                                                Click="OpenPatient_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty state -->
                    <TextBlock x:Name="NoVisitsText"
                               Text="{DynamicResource Dashboard.NoRecentVisits}"
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,24,0,24"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
