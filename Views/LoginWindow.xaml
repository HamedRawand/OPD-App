<Window x:Class="OPDClinic.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rx Writer — Login"
        Height="380" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource ContentBgBrush}"
        FlowDirection="{DynamicResource App.FlowDirection}">

    <Grid>
        <StackPanel VerticalAlignment="Center" Margin="44,0">

            <TextBlock Text="{DynamicResource App.Title}"
                       FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,4"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="{DynamicResource Login.Subtitle}"
                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,28"/>

            <TextBlock Text="{DynamicResource Login.Username}"
                       Style="{StaticResource FormLabel}"/>
            <TextBox x:Name="UsernameBox" Style="{StaticResource FormTextBox}"
                     Margin="0,4,0,14" FlowDirection="LeftToRight"/>

            <TextBlock Text="{DynamicResource Login.Password}"
                       Style="{StaticResource FormLabel}"/>
            <PasswordBox x:Name="PasswordBox"
                         Padding="10,8" FontSize="13"
                         BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                         Margin="0,4,0,0" FlowDirection="LeftToRight"/>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}"
                       FontSize="12" Margin="0,10,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed"/>

            <Button Content="{DynamicResource Login.SignIn}"
                    Style="{StaticResource PrimaryButton}"
                    Height="40" FontSize="14" FontWeight="SemiBold"
                    Margin="0,20,0,8"
                    IsDefault="True"
                    Click="SignIn_Click"/>

            <!-- Forgot password link -->
            <Button x:Name="ForgotPasswordBtn"
                    Content="Forgot your password?"
                    HorizontalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{StaticResource PrimaryBrush}"
                    FontSize="12"
                    Cursor="Hand"
                    Margin="0,4,0,0"
                    Click="ForgotPassword_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   TextDecorations="Underline"
                                   HorizontalAlignment="Center"/>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
