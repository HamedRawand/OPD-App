<Window x:Class="OPDClinic.Views.ResetPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset Password / تغییر رمز"
        Width="380" Height="320" MinHeight="260"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource ContentBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Scrollable form content -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="28,24,28,12">
            <StackPanel>

                <TextBlock x:Name="SubTitle" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,20" TextWrapping="Wrap"/>

                <TextBlock Text="New Password *" Style="{StaticResource FormLabel}"/>
                <PasswordBox x:Name="PasswordBox"
                             Padding="10,8" FontSize="13" Margin="0,4,0,12"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"/>

                <TextBlock Text="Confirm Password *" Style="{StaticResource FormLabel}"/>
                <PasswordBox x:Name="ConfirmBox"
                             Padding="10,8" FontSize="13" Margin="0,4,0,8"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"/>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}"
                           FontSize="12" Visibility="Collapsed" Margin="0,0,0,4"
                           TextWrapping="Wrap"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Sticky footer with buttons — always visible -->
        <Border Grid.Row="1" Background="White" Padding="28,14,28,20"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                        IsCancel="True" Padding="20,8" Margin="0,0,10,0"/>
                <Button Content="Reset Password"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        Padding="20,8" Click="Reset_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
