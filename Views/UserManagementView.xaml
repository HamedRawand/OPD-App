<UserControl x:Class="OPDClinic.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OPDClinic">

    <Grid Background="{StaticResource ContentBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" Padding="24,16"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Text="{DynamicResource Users.Title}"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding UserCount, StringFormat='{}{0} user(s)'}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" VerticalAlignment="Center"
                               Margin="0,0,16,0"/>
                    <Button Content="📧 Email Settings"
                            Style="{StaticResource SecondaryButton}"
                            Click="SmtpSettings_Click"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"/>
                    <Button Content="{DynamicResource Users.Btn.Add}"
                            Style="{StaticResource PrimaryButton}"
                            Click="AddUser_Click"
                            VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Filter bar -->
        <Border Grid.Row="1" Background="White" Padding="24,10"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                           Text="{Binding StatusText}" Margin="16,0,0,0"/>
                <TextBox Style="{StaticResource FormTextBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Width="280"
                         Tag="Search by username, name, or role…"
                         HorizontalAlignment="Left"/>
            </DockPanel>
        </Border>

        <!-- User DataGrid + empty state -->
        <Grid Grid.Row="2">
        <DataGrid Style="{StaticResource AppDataGrid}"
                  ItemsSource="{Binding Users}"
                  Margin="24,16"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  AutoGenerateColumns="False">

            <DataGrid.Columns>

                <DataGridTextColumn Header="{DynamicResource Users.Col.Username}" Width="140"
                                    Binding="{Binding Username}"/>

                <DataGridTextColumn Header="{DynamicResource Users.Col.FullName}" Width="160"
                                    Binding="{Binding FullName}"/>

                <DataGridTextColumn Header="Email" Width="190"
                                    Binding="{Binding Email}"/>

                <DataGridTextColumn Header="{DynamicResource Users.Col.Role}" Width="120"
                                    Binding="{Binding RoleDisplayName}"/>

                <DataGridTemplateColumn Header="{DynamicResource Users.Col.Status}" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border CornerRadius="3" Padding="6,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#C6F6D5"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Background" Value="#FED7D7"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Active"/>
                                                <Setter Property="Foreground" Value="#276749"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Text" Value="Inactive"/>
                                                        <Setter Property="Foreground" Value="#C53030"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <!-- Locked badge -->
                                <Border CornerRadius="3" Padding="6,2" Margin="4,0,0,0"
                                        Background="#FEFCBF">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="Locked" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#744210"/>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="{DynamicResource Users.Col.LastLogin}" Width="160"
                                    Binding="{Binding LastLogin, StringFormat={}{0:yyyy-MM-dd HH:mm}}"/>

                <!-- Actions -->
                <DataGridTemplateColumn Header="{DynamicResource Users.Col.Actions}" Width="*" MinWidth="320">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,2">

                                <Button Content="{DynamicResource Common.Edit}"
                                        Style="{StaticResource ActionButton}"
                                        Padding="10,4" FontSize="11"
                                        Tag="{Binding}"
                                        Click="EditUser_Click"
                                        Margin="0,0,6,0"/>

                                <!-- Toggle Active/Inactive -->
                                <Button Padding="10,4" FontSize="11" Margin="0,0,6,0"
                                        Command="{Binding DataContext.ToggleActiveCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Setter Property="Content" Value="⊘ Deactivate"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Content" Value="✓ Activate"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Unlock (only when locked) -->
                                <Button Padding="10,4" FontSize="11" Margin="0,0,6,0"
                                        Command="{Binding DataContext.UnlockUserCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Setter Property="Content" Value="🔓 Unlock"/>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="🔑 Reset Pwd"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="10,4" FontSize="11" Margin="0,0,6,0"
                                        Command="{Binding DataContext.ResetPasswordCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>

                                <Button Content="{DynamicResource Common.Delete}"
                                        Style="{StaticResource ActionButton}"
                                        Foreground="{StaticResource DangerBrush}"
                                        Padding="10,4" FontSize="11"
                                        Command="{Binding DataContext.DeleteUserCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- Empty state — shown when no users exist -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding UserCount, Converter={x:Static local:Converters.ZeroToVisible}}">
            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="52"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource BorderBrush}"/>
            <TextBlock Text="No users found"
                       FontSize="15" FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,12,0,4"/>
            <TextBlock Text="Click '+ Add User' to create the first user account."
                       FontSize="12" HorizontalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>
        </Grid>

    </Grid>
</UserControl>
