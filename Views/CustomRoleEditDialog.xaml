<Window x:Class="OPDClinic.Views.CustomRoleEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom Role"
        Width="560" Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource ContentBgBrush}"
        FlowDirection="LeftToRight">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Scrollable form content -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24,28,12">

                <!-- Title -->
                <TextBlock x:Name="TitleText"
                           FontSize="17" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,12"/>

                <!-- Built-in role info banner (shown only for system roles) -->
                <Border x:Name="SystemRoleBanner"
                        Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                        CornerRadius="6" Padding="12,8" Margin="0,0,0,16"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔒" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock FontSize="12" Foreground="#1D4ED8" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="This is a built-in role. You can change its permissions but cannot rename or delete it."/>
                    </StackPanel>
                </Border>

                <!-- Role Name -->
                <TextBlock Text="Role Name" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="NameBox"
                         Style="{StaticResource FormTextBox}"
                         Margin="0,0,0,12"/>

                <!-- Description -->
                <TextBlock Text="Description (one sentence)" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="DescriptionBox"
                         Style="{StaticResource FormTextBox}"
                         TextWrapping="Wrap" AcceptsReturn="False"
                         Margin="0,0,0,16"/>

                <!-- Permissions -->
                <TextBlock Text="PERMISSIONS" FontSize="10" FontWeight="SemiBold"
                           Foreground="#4A6FA5" Margin="0,0,0,8"/>

                <ScrollViewer x:Name="PermissionsScrollView" MaxHeight="380" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="16,12">
                        <!-- Populated dynamically in code-behind BuildPermissionsUI() -->
                        <StackPanel x:Name="PermissionsContainer"/>
                    </Border>
                </ScrollViewer>

                <!-- Additional Notes -->
                <TextBlock Text="Additional Notes (optional)" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="NotesBox"
                         Style="{StaticResource FormTextBox}"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         Height="60" VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,4"/>
                <TextBlock Text="Document any responsibilities beyond the standard permission list above."
                           FontSize="11" FontStyle="Italic"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,8" TextWrapping="Wrap"/>

                <!-- Error -->
                <TextBlock x:Name="ErrorText"
                           Foreground="{StaticResource DangerBrush}"
                           FontSize="12" TextWrapping="Wrap"
                           Visibility="Collapsed" Margin="0,0,0,4"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Sticky button footer -->
        <Border Grid.Row="1"
                Background="{StaticResource ContentBgBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="28,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        IsCancel="True" Padding="20,8" Margin="0,0,10,0"/>
                <Button x:Name="SaveBtn"
                        Content="Save Role"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        Padding="20,8" Click="Save_Click"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
