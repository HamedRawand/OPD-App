<Window x:Class="OPDClinic.Views.SmtpSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Email / SMTP Settings"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="LeftToRight"
        Background="{StaticResource ContentBgBrush}">

    <StackPanel Margin="28,24">

        <!-- Title -->
        <TextBlock Text="Email Settings"
                   FontSize="17" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,6"/>

        <TextBlock TextWrapping="Wrap" FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Margin="0,0,0,20">
            Configure a Gmail account to send password-reset emails.
            You need a Gmail App Password (not your regular password).
            Generate one at: myaccount.google.com → Security → 2-Step Verification → App passwords.
        </TextBlock>

        <!-- Sender Email -->
        <TextBlock Text="Gmail Address (sender)" Style="{StaticResource FormLabel}"/>
        <TextBox x:Name="SenderEmailBox"
                 Style="{StaticResource FormTextBox}"
                 Margin="0,4,0,14"/>

        <!-- App Password -->
        <TextBlock Text="Gmail App Password (16 characters)" Style="{StaticResource FormLabel}"/>
        <PasswordBox x:Name="AppPasswordBox"
                     Padding="10,8" FontSize="13"
                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                     Margin="0,4,0,4"/>
        <TextBlock Text="Enter the 16-character App Password generated in your Google Account security settings."
                   FontSize="11" FontStyle="Italic"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,14"/>

        <!-- Sender Name -->
        <TextBlock Text="Sender Display Name" Style="{StaticResource FormLabel}"/>
        <TextBox x:Name="SenderNameBox"
                 Style="{StaticResource FormTextBox}"
                 Margin="0,4,0,20"/>

        <!-- Test Email -->
        <Border Background="#EEF2F7" CornerRadius="6" Padding="14,12" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Send a test email to verify your settings:" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="TestEmailBox"
                             Width="240" Padding="8,6" FontSize="13"
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                             Tag="recipient@example.com"
                             Margin="0,0,8,0"/>
                    <Button x:Name="TestBtn"
                            Content="📧 Send Test"
                            Style="{StaticResource SecondaryButton}"
                            Padding="12,6"
                            Click="Test_Click"/>
                </StackPanel>
                <TextBlock x:Name="TestStatusText"
                           FontSize="12" TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Status -->
        <TextBlock x:Name="StatusText"
                   FontSize="12" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,0,0,12"/>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Style="{StaticResource SecondaryButton}"
                    IsCancel="True" Padding="20,8" Margin="0,0,10,0"/>
            <Button Content="💾 Save Settings"
                    Style="{StaticResource PrimaryButton}"
                    Padding="20,8" Click="Save_Click"/>
        </StackPanel>

    </StackPanel>
</Window>
