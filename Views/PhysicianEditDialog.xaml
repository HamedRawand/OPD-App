<Window x:Class="OPDClinic.Views.PhysicianEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource PhysEdit.Title}"
        Height="720" Width="680"
        MinHeight="600" MinWidth="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FlowDirection="{DynamicResource App.FlowDirection}"
        Background="{StaticResource ContentBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="24,14">
            <TextBlock x:Name="HeaderTitle"
                       Foreground="White" FontSize="16" FontWeight="Bold"/>
        </Border>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel>

                <!-- English Section -->
                <TextBlock Text="{DynamicResource PhysEdit.Section.English}" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="{DynamicResource PhysEdit.NameEng}" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="NameEngBox" Style="{StaticResource FormTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="{DynamicResource PhysEdit.SpecialityEng}" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="SpecialityEngBox" Style="{StaticResource FormTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
                            <TextBlock Text="{DynamicResource PhysEdit.OtherSpecialityEng}" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="OtherSpecialityEngBox" Style="{StaticResource FormTextBox}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Dari Section -->
                <TextBlock Text="{DynamicResource PhysEdit.Section.Dari}" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="{DynamicResource PhysEdit.NameDari}" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="NameDariBox" Style="{StaticResource FormTextBox}"
                                     FlowDirection="RightToLeft"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="{DynamicResource PhysEdit.SpecialityDari}" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="SpecialityDariBox" Style="{StaticResource FormTextBox}"
                                     FlowDirection="RightToLeft"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
                            <TextBlock Text="{DynamicResource PhysEdit.OtherSpecialityDari}" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="OtherSpecialityDariBox" Style="{StaticResource FormTextBox}"
                                     FlowDirection="RightToLeft"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Symbol / Logo Section -->
                <TextBlock Text="{DynamicResource PhysEdit.Section.Symbol}" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Image preview box -->
                        <Border Grid.Column="0"
                                Width="120" Height="120"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1.5" CornerRadius="6"
                                Background="#F8FAFF"
                                HorizontalAlignment="Left">
                            <Grid>
                                <!-- Placeholder icon when no image -->
                                <TextBlock x:Name="SymbolPlaceholder"
                                           Text="🖼" FontSize="36"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <!-- Actual image -->
                                <Image x:Name="SymbolPreview"
                                       Stretch="Uniform"
                                       Visibility="Collapsed"
                                       Margin="4"/>
                            </Grid>
                        </Border>

                        <!-- Right side: hint + buttons -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource PhysEdit.Symbol.Hint}"
                                       Style="{StaticResource FormLabel}"
                                       TextWrapping="Wrap"
                                       FontWeight="Normal"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{DynamicResource PhysEdit.Symbol.Browse}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="12,6"
                                        Click="BrowseSymbol_Click"
                                        Margin="0,0,8,0"/>
                                <Button x:Name="ClearSymbolBtn"
                                        Content="{DynamicResource PhysEdit.Symbol.Clear}"
                                        Style="{StaticResource ActionButton}"
                                        Foreground="{StaticResource DangerBrush}"
                                        Padding="12,6"
                                        Visibility="Collapsed"
                                        Click="ClearSymbol_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Contact Section -->
                <TextBlock Text="{DynamicResource PhysEdit.Section.Contact}" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="{DynamicResource PhysEdit.Contact}" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="ContactBox" Style="{StaticResource FormTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="{DynamicResource PhysEdit.WhatsApp}" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="WhatsAppBox" Style="{StaticResource FormTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="{DynamicResource PhysEdit.Reception}" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="ReceptionBox" Style="{StaticResource FormTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.ColumnSpan="3">
                            <TextBlock Text="{DynamicResource PhysEdit.Address}" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="AddressBox" Style="{StaticResource MultiLineTextBox}"
                                     MinHeight="60"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Error -->
                <Border x:Name="ErrorBorder" Background="#FEE2E2" CornerRadius="5"
                        Padding="12,8" Margin="0,4,0,4" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Foreground="#B91C1C" FontSize="12"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" Padding="24,14"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="{DynamicResource Common.Save}"
                        Style="{StaticResource PrimaryButton}"
                        Click="Save_Click" MinWidth="120"/>
                <Button DockPanel.Dock="Right"
                        Content="{DynamicResource Common.Cancel}"
                        Style="{StaticResource SecondaryButton}"
                        IsCancel="True"
                        Click="Cancel_Click"
                        Margin="0,0,10,0" MinWidth="100"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
