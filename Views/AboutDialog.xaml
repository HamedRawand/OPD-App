<Window x:Class="OPDClinic.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Rx Writer"
        Height="310" Width="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ContentBgBrush}"
        FlowDirection="LeftToRight">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- blue header  -->
            <RowDefinition Height="*"/>     <!-- body         -->
            <RowDefinition Height="Auto"/>  <!-- close button -->
        </Grid.RowDefinitions>

        <!-- ── Header ──────────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="28,22">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Rx badge -->
                <Border Width="52" Height="52" Background="#FFFFFF22"
                        CornerRadius="26" Margin="0,0,18,0">
                    <TextBlock Text="Rx" FontSize="20" FontWeight="Bold"
                               Foreground="White" FontStyle="Italic"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Rx Writer"
                               FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <TextBlock x:Name="VersionText"
                               FontSize="12" Foreground="#BBDEFB" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Body ────────────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="1" Margin="28,22,28,8">

            <TextBlock Text="Outpatient Department Clinic Management System"
                       FontSize="12" Foreground="#555555" TextWrapping="Wrap"
                       LineHeight="20"/>

            <TextBlock Text="Designed for Afghan gynecology / obstetrics OPD clinics."
                       FontSize="11" Foreground="#777777" Margin="0,6,0,0"
                       TextWrapping="Wrap" LineHeight="18"/>

            <!-- Divider -->
            <Border Height="1" Background="#E2E8F0" Margin="0,18,0,18"/>

            <!-- Contact row -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets"
                           FontSize="15" Foreground="{StaticResource PrimaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Feedback &amp; Support:"
                           FontSize="11" FontWeight="SemiBold" Foreground="#444"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button x:Name="EmailBtn"
                        Content="info.rxwriter@gmail.com"
                        FontSize="11" Foreground="{StaticResource PrimaryBrush}"
                        Background="Transparent" BorderThickness="0"
                        Padding="0" Cursor="Hand"
                        Click="EmailBtn_Click"
                        ToolTip="Click to send an email"/>
            </StackPanel>


        </StackPanel>

        <!-- ── Close button ─────────────────────────────────────────────────── -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,10">
            <Button Content="Close" Style="{StaticResource SecondaryButton}"
                    MinWidth="90" HorizontalAlignment="Right"
                    IsCancel="True" Click="Close_Click"/>
        </Border>
    </Grid>
</Window>
