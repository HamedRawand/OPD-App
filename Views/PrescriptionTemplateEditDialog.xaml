<Window x:Class="OPDClinic.Views.PrescriptionTemplateEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OPDClinic.Views"
        Title="Prescription Template"
        Height="760" Width="720"
        MinHeight="560" MinWidth="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FlowDirection="{DynamicResource App.FlowDirection}"
        Background="{StaticResource ContentBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="24,14">
            <TextBlock x:Name="HeaderTitle"
                       Foreground="White" FontSize="16" FontWeight="Bold"/>
        </Border>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel>

                <!-- Row 1: Name + Description -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource RxTemplate.Name}" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="NameBox" Style="{StaticResource FormTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource RxTemplate.Description}" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="DescriptionBox" Style="{StaticResource FormTextBox}"/>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Default Diagnosis -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="{DynamicResource RxTemplate.DefaultDiagnosis}" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="DefaultDiagnosisBox" Style="{StaticResource MultiLineTextBox}" MinHeight="50"/>
                </StackPanel>

                <!-- Row 3: Default Clinical Findings -->
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="{DynamicResource RxTemplate.DefaultFindings}" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="DefaultFindingsBox" Style="{StaticResource MultiLineTextBox}" MinHeight="50"/>
                </StackPanel>

                <TextBlock Text="{DynamicResource RxTemplate.PrefillHint}"
                           FontSize="11" FontStyle="Italic"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,14"/>

                <!-- Embedded Rx editor — same medicine/lab test/footer note UI as a real visit -->
                <TextBlock Text="{DynamicResource RxTemplate.RxSection}"
                           Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                    <views:PrescriptionView x:Name="RxView" Margin="12,4"/>
                </Border>

                <!-- Error -->
                <Border x:Name="ErrorBorder" Background="#FEE2E2" CornerRadius="5"
                        Padding="12,8" Margin="0,14,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Foreground="#B91C1C" FontSize="12"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" Padding="24,14"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="{DynamicResource Common.Save}"
                        Style="{StaticResource PrimaryButton}"
                        Click="Save_Click" MinWidth="120"/>
                <Button DockPanel.Dock="Right"
                        Content="{DynamicResource Common.Cancel}"
                        Style="{StaticResource SecondaryButton}"
                        IsCancel="True"
                        Click="Cancel_Click"
                        Margin="0,0,10,0" MinWidth="100"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
