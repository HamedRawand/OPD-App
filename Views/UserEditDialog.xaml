<Window x:Class="OPDClinic.Views.UserEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource UserEdit.Title}"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="{DynamicResource App.FlowDirection}"
        Background="{StaticResource ContentBgBrush}">

    <StackPanel Margin="28,24">

        <!-- Title -->
        <TextBlock x:Name="TitleText"
                   FontSize="17" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,20"/>

        <!-- Username -->
        <TextBlock Text="{DynamicResource UserEdit.Username}" Style="{StaticResource FormLabel}"/>
        <TextBox x:Name="UsernameBox"
                 Style="{StaticResource FormTextBox}"
                 Margin="0,0,0,12"/>

        <!-- Full Name -->
        <TextBlock Text="{DynamicResource UserEdit.FullName}" Style="{StaticResource FormLabel}"/>
        <TextBox x:Name="FullNameBox"
                 Style="{StaticResource FormTextBox}"
                 Margin="0,0,0,12"/>

        <!-- Email -->
        <TextBlock Text="Email Address (for password reset)" Style="{StaticResource FormLabel}"/>
        <TextBox x:Name="EmailBox"
                 Style="{StaticResource FormTextBox}"
                 FlowDirection="LeftToRight"
                 Margin="0,0,0,4"/>
        <TextBlock Text="A temporary password will be sent here if the user clicks 'Forgot Password'."
                   FontSize="11" FontStyle="Italic"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>

        <!-- Role -->
        <TextBlock Text="{DynamicResource UserEdit.Role}" Style="{StaticResource FormLabel}"/>
        <ComboBox x:Name="RoleBox"
                  Style="{StaticResource FormComboBox}"
                  Margin="0,0,0,12"/>

        <!-- Link to Physician (visible only when Role = Doctor) -->
        <Border x:Name="PhysicianLinkSection" Visibility="Collapsed" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Linked Physician" Style="{StaticResource FormLabel}"/>
                <ComboBox x:Name="PhysicianBox"
                          Style="{StaticResource FormComboBox}"
                          DisplayMemberPath="NameEng"/>
                <TextBlock Text="Link this doctor account to their physician profile for patient filtering."
                           FontSize="11" FontStyle="Italic"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Password section -->
        <Border x:Name="PasswordSection" Margin="0,0,0,0">
            <StackPanel>
                <TextBlock x:Name="PasswordLabel"
                           Style="{StaticResource FormLabel}"/>
                <PasswordBox x:Name="PasswordBox"
                             Padding="10,8" FontSize="13" Margin="0,4,0,12"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"/>

                <TextBlock x:Name="ConfirmLabel"
                           Style="{StaticResource FormLabel}"/>
                <PasswordBox x:Name="ConfirmBox"
                             Padding="10,8" FontSize="13" Margin="0,4,0,12"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"/>

                <!-- Edit-only note -->
                <TextBlock x:Name="PasswordNote"
                           Text="{DynamicResource UserEdit.PasswordNote}"
                           FontSize="11" FontStyle="Italic"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,12"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Active checkbox -->
        <CheckBox x:Name="IsActiveBox"
                  Content="{DynamicResource UserEdit.IsActive}"
                  IsChecked="True" Margin="0,4,0,16"
                  Foreground="{StaticResource TextPrimaryBrush}"/>

        <!-- Must change password checkbox -->
        <CheckBox x:Name="MustChangePwdBox"
                  Content="{DynamicResource UserEdit.MustChangePwd}"
                  IsChecked="True" Margin="0,0,0,20"
                  Foreground="{StaticResource TextSecondaryBrush}"
                  FontSize="12"/>

        <!-- Error message -->
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}"
                   FontSize="12" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,0,0,12"/>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource Common.Cancel}"
                    Style="{StaticResource SecondaryButton}"
                    IsCancel="True" Padding="20,8" Margin="0,0,10,0"/>
            <Button x:Name="SaveBtn"
                    Content="{DynamicResource Common.Save}"
                    Style="{StaticResource PrimaryButton}"
                    Padding="20,8" Click="Save_Click"/>
        </StackPanel>

    </StackPanel>
</Window>
