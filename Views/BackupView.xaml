<UserControl x:Class="OPDClinic.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource ContentBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" Padding="24,16"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="{DynamicResource Backup.Title}" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="32,24">
            <StackPanel MaxWidth="680" HorizontalAlignment="Left">

                <!-- ═══ BACKUP SECTION ═══ -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,24" Padding="24,20">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Backup.Create.Title}" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="پشتیبان‌گیری از داده‌ها" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FlowDirection="RightToLeft" HorizontalAlignment="Left"
                                   Margin="0,0,0,16"/>

                        <!-- Backup folder row -->
                        <TextBlock Text="Backup folder / پوشه ذخیره"
                                   Style="{StaticResource FormLabel}"/>
                        <DockPanel Margin="0,4,0,16">
                            <Button DockPanel.Dock="Right" Content="Change…"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="14,7" Margin="10,0,0,0"
                                    Click="ChangeFolder_Click"/>
                            <TextBox x:Name="BackupFolderBox"
                                     Style="{StaticResource FormTextBox}"
                                     IsReadOnly="True"/>
                        </DockPanel>

                        <!-- Encryption password row -->
                        <TextBlock Text="Encryption password (optional) / رمز رمزگذاری"
                                   Style="{StaticResource FormLabel}"/>
                        <DockPanel Margin="0,4,0,4">
                            <PasswordBox x:Name="BackupPasswordBox"
                                         Height="36" FontSize="13"
                                         Padding="10,0"
                                         PasswordChanged="BackupPassword_Changed"/>
                        </DockPanel>
                        <!-- Encryption status hint -->
                        <TextBlock x:Name="EncryptionHint"
                                   FontSize="11" Margin="0,0,0,16" TextWrapping="Wrap"
                                   Text="⚠  No password — backup will be unencrypted (.zip). Anyone with the file can read patient data."
                                   Foreground="#92400E"/>

                        <Button x:Name="BackupBtn"
                                Content="{DynamicResource Backup.Btn.Create}"
                                Style="{StaticResource PrimaryButton}"
                                Padding="24,9" FontSize="13"
                                HorizontalAlignment="Left"
                                Click="Backup_Click"/>

                        <TextBlock x:Name="BackupStatusText" FontSize="12"
                                   Margin="0,12,0,0" TextWrapping="Wrap"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- ═══ RESTORE SECTION ═══ -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,24" Padding="24,20">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Backup.Restore.Title}" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                        <!-- Warning banner -->
                        <Border Background="#FFF5F5" BorderBrush="{StaticResource DangerBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="12,10"
                                Margin="0,0,0,16">
                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource DangerBrush}">
                                ⚠  Restoring will replace ALL current data with the backup.
                                The application will restart automatically after restore.
                                Make a fresh backup first if you want to preserve current data.
                            </TextBlock>
                        </Border>

                        <!-- File picker -->
                        <TextBlock Text="Select backup file / انتخاب فایل پشتیبان"
                                   Style="{StaticResource FormLabel}"/>
                        <DockPanel Margin="0,4,0,12">
                            <Button DockPanel.Dock="Right" Content="Browse…"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="14,7" Margin="10,0,0,0"
                                    Click="BrowseRestore_Click"/>
                            <TextBox x:Name="RestoreFileBox"
                                     Style="{StaticResource FormTextBox}"
                                     IsReadOnly="True"
                                     Tag="No file selected…"/>
                        </DockPanel>

                        <!-- Encrypted backup password row — shown only for .rxb files -->
                        <StackPanel x:Name="RestorePasswordPanel" Visibility="Collapsed" Margin="0,0,0,16">
                            <TextBlock Text="Backup password / رمز عبور پشتیبان‌گیری"
                                       Style="{StaticResource FormLabel}"/>
                            <PasswordBox x:Name="RestorePasswordBox"
                                         Height="36" FontSize="13" Padding="10,0"/>
                            <TextBlock Text="🔒 This backup is encrypted. Enter the password used when it was created."
                                       FontSize="11" Foreground="#1565C0" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Button x:Name="RestoreBtn"
                                Content="{DynamicResource Backup.Btn.Restore}"
                                Style="{StaticResource PrimaryButton}"
                                Padding="24,9" FontSize="13"
                                HorizontalAlignment="Left"
                                IsEnabled="False"
                                Click="Restore_Click">
                            <Button.Resources>
                                <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#C53030"/>
                            </Button.Resources>
                        </Button>

                        <TextBlock x:Name="RestoreStatusText" FontSize="12"
                                   Margin="0,12,0,0" TextWrapping="Wrap"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- ═══ EXISTING BACKUPS ═══ -->
                <Border Style="{StaticResource Card}" Padding="24,20">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,16">
                            <Button DockPanel.Dock="Right" Content="↻ Refresh"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="14,6" FontSize="12"
                                    Click="RefreshList_Click"/>
                            <TextBlock Text="Saved Backups" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Empty state -->
                        <TextBlock x:Name="EmptyText"
                                   Text="No backups found in the backup folder."
                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,16"
                                   Visibility="Visible"/>

                        <!-- Backup list -->
                        <ItemsControl x:Name="BackupList" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,0,0,1" Padding="4,10">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Content="↩ Restore"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="10,5" FontSize="11"
                                                        Tag="{Binding}"
                                                        Click="RestoreFromList_Click"
                                                        Margin="0,0,8,0"/>
                                                <Button Content="✕"
                                                        Style="{StaticResource ActionButton}"
                                                        Foreground="{StaticResource DangerBrush}"
                                                        Padding="10,5" FontSize="11"
                                                        Tag="{Binding}"
                                                        Click="DeleteBackup_Click"/>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding FileName}"
                                                               FontSize="13"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontWeight="SemiBold"/>
                                                    <!-- Encrypted badge -->
                                                    <Border Background="#EFF6FF" CornerRadius="3"
                                                            Padding="6,1" Margin="8,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEncrypted}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="🔒 Encrypted" FontSize="10"
                                                                   Foreground="#1565C0" FontWeight="SemiBold"/>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding CreatedText}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Margin="0,0,16,0"/>
                                                    <TextBlock Text="{Binding SizeText}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
