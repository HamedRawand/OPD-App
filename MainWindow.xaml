<Window x:Class="OPDClinic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="OPD Clinic" Height="680" Width="1100"
        MinHeight="520" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ContentBgBrush}"
        FlowDirection="{DynamicResource App.FlowDirection}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR ═══ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                FlowDirection="LeftToRight">
            <DockPanel>

                <!-- Logo / Title -->
                <Border DockPanel.Dock="Top" Padding="20,24,20,16"
                        BorderBrush="#2E4A6A" BorderThickness="0,0,0,1">
                    <TextBlock Text="{DynamicResource App.Title}"
                               Foreground="White" FontSize="17" FontWeight="Bold"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Bottom: user info + language toggle + logout -->
                <Border DockPanel.Dock="Bottom" Padding="14,14"
                        BorderBrush="#2E4A6A" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock x:Name="UserNameText" Foreground="White"
                                   FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="UserRoleText" Foreground="#7EB3E8"
                                   FontSize="11" Margin="0,2,0,10"/>

                        <!-- Check for Updates -->
                        <Button x:Name="NavUpdatesBtn"
                                Style="{StaticResource NavButton}"
                                Foreground="#7EB3E8"
                                Click="NavUpdates_Click"
                                ToolTip="Check for software updates"
                                Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" Width="22" Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Nav.Updates}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Language toggle -->
                        <Button x:Name="LangToggleBtn"
                                Style="{StaticResource NavButton}"
                                Foreground="#7EB3E8"
                                Click="LangToggle_Click"
                                ToolTip="Switch language / تغییر زبان"
                                Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE12B;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" Width="22" Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Lang.Toggle}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}"
                                Foreground="#FC8181"
                                Click="Logout_Click"
                                ToolTip="Sign out of OPD Clinic">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8FB;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" Width="22" Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Nav.Logout}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Nav items -->
                <StackPanel Margin="8,12">

                    <Button x:Name="NavDashboardBtn"
                            Style="{StaticResource NavButton}"
                            Click="NavDashboard_Click"
                            ToolTip="Clinic overview and quick actions">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="15" Width="22" Margin="0,0,10,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Nav.Dashboard}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButton}"
                            Click="NavPatients_Click"
                            ToolTip="View and manage patient visits">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="15" Width="22" Margin="0,0,10,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Nav.Patients}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Admin-only items -->
                    <StackPanel x:Name="AdminNav" Visibility="Collapsed">

                        <Button Style="{StaticResource NavButton}"
                                Click="NavPhysicians_Click"
                                ToolTip="Manage physician profiles">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="15" Width="22" Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Nav.Physicians}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}"
                                Click="NavMedicines_Click"
                                ToolTip="Manage the medicine catalog">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="15" Width="22" Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Nav.Medicines}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}"
                                Click="NavUsers_Click"
                                ToolTip="Manage user accounts and roles">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="15" Width="22" Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Nav.Users}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}"
                                Click="NavImport_Click"
                                ToolTip="Import data from Access database">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="15" Width="22" Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Nav.Import}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}"
                                Click="NavBackup_Click"
                                ToolTip="Backup and restore the clinic database">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="15" Width="22" Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Nav.Backup}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}"
                                Click="NavOptions_Click"
                                ToolTip="Manage medicine categories, forms and notes">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="15" Width="22" Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Nav.Options}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}"
                                Click="NavSettings_Click"
                                ToolTip="Customise report design and print settings">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE771;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="15" Width="22" Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Print Settings"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ═══ CONTENT AREA ═══ -->
        <ContentControl x:Name="ContentArea" Grid.Column="1"
                        Background="{StaticResource ContentBgBrush}"/>

        <!-- ═══ SESSION LOCK OVERLAY ═══ -->
        <Grid x:Name="LockOverlay"
              Grid.Column="0" Grid.ColumnSpan="2"
              Panel.ZIndex="100"
              Visibility="Collapsed"
              FlowDirection="LeftToRight"
              Background="#CC1A1A2E">
            <Border Style="{StaticResource Card}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="360" Padding="40,36">
                <StackPanel>
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                               FontSize="48" HorizontalAlignment="Center"
                               Foreground="{StaticResource PrimaryBrush}"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="Session Locked" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="LockUserText" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,24"/>
                    <TextBlock Text="Enter your password to continue:"
                               FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,8"/>
                    <PasswordBox x:Name="LockPasswordBox"
                                 Height="36" FontSize="13" Padding="8,0"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 BorderThickness="1"
                                 KeyDown="LockPasswordBox_KeyDown"/>
                    <TextBlock x:Name="LockErrorText"
                               Text="Incorrect password — please try again."
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="11" Margin="0,6,0,0"
                               Visibility="Collapsed"/>
                    <Button Content="Unlock" Style="{StaticResource PrimaryButton}"
                            Margin="0,16,0,0" Click="Unlock_Click"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
