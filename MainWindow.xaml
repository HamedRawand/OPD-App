<Window x:Class="OPDClinic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Rx Writer" Height="680" Width="1100"
        MinHeight="480" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ContentBgBrush}"
        FlowDirection="{DynamicResource App.FlowDirection}"
        SizeChanged="Window_SizeChanged">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR ═══ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                FlowDirection="LeftToRight">
            <DockPanel>

                <!-- Logo / Title -->
                <Border DockPanel.Dock="Top" Padding="20,24,20,16"
                        BorderBrush="#2E4A6A" BorderThickness="0,0,0,1">
                    <TextBlock Text="{DynamicResource App.Title}"
                               Foreground="White" FontSize="17" FontWeight="Bold"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- ═══ BOTTOM PANEL — user card + icon strip ═══ -->
                <Border DockPanel.Dock="Bottom" Padding="12,10"
                        BorderBrush="#2E4A6A" BorderThickness="0,1,0,0">
                    <StackPanel>

                        <!-- User identity card: initials circle + name/role -->
                        <Grid Margin="4,0,4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Initials circle -->
                            <Border Grid.Column="0"
                                    Width="32" Height="32" CornerRadius="16"
                                    Background="#1976D2" Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="UserInitialsText"
                                           Foreground="White" FontSize="11" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontFamily="Calibri"/>
                            </Border>
                            <!-- Name + role stacked -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="UserNameText"
                                           Foreground="White" FontSize="12.5" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="UserRoleText"
                                           Foreground="#7EB3E8" FontSize="11"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>

                        <!-- Thin divider -->
                        <Border Height="1" Background="#2E4A6A" Margin="-12,0,-12,8"/>

                        <!-- Icon strip: utilities left | separator | logout right -->
                        <Grid Margin="4,0,4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: utility icons -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button x:Name="NavHelpBtn"
                                        Style="{StaticResource IconStripButton}"
                                        Foreground="#7EB3E8"
                                        Click="NavHelp_Click"
                                        ToolTip="Help / Manual">
                                    <Viewbox Width="15" Height="15" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource Ico.Help}"/></Canvas></Viewbox>
                                </Button>
                                <Button x:Name="NavAboutBtn"
                                        Style="{StaticResource IconStripButton}"
                                        Foreground="#7EB3E8"
                                        Click="NavAbout_Click"
                                        ToolTip="About Rx Writer">
                                    <Viewbox Width="15" Height="15" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource Ico.Info}"/></Canvas></Viewbox>
                                </Button>
                                <Button x:Name="NavUpdatesBtn"
                                        Style="{StaticResource IconStripButton}"
                                        Foreground="#7EB3E8"
                                        Click="NavUpdates_Click"
                                        ToolTip="Check for Updates">
                                    <Viewbox Width="15" Height="15" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource Ico.Sync}"/></Canvas></Viewbox>
                                </Button>
                                <Button x:Name="LangToggleBtn"
                                        Style="{StaticResource IconStripButton}"
                                        Foreground="#7EB3E8"
                                        Click="LangToggle_Click"
                                        ToolTip="Switch language / تغییر زبان">
                                    <Viewbox Width="15" Height="15" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource Ico.Globe}"/></Canvas></Viewbox>
                                </Button>
                            </StackPanel>

                            <!-- Right: separator + logout -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Border Width="1" Background="#2E4A6A"
                                        Margin="4,4" VerticalAlignment="Stretch"/>
                                <Button Style="{StaticResource IconStripButton}"
                                        Foreground="#FC8181"
                                        Click="Logout_Click"
                                        ToolTip="Sign out of Rx Writer">
                                    <Viewbox Width="15" Height="15" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource Ico.Logout}"/></Canvas></Viewbox>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Version + contact email -->
                        <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                            <TextBlock x:Name="AppVersionText"
                                       Foreground="#4A6FA5" FontSize="10"
                                       FontStyle="Italic" Margin="0,0,6,0"/>
                            <TextBlock Text="·" Foreground="#2E4A6A" FontSize="10" Margin="0,0,6,0"/>
                            <Button x:Name="ContactEmailBtn"
                                    Content="info.rxwriter@gmail.com"
                                    Foreground="#4A6FA5" FontSize="10"
                                    FontStyle="Italic"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="0" HorizontalAlignment="Left"
                                    Cursor="Hand" Click="ContactEmail_Click"
                                    ToolTip="Send feedback or suggestions"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- Nav items — scrollable so items never clip on short/high-DPI screens -->
                <ScrollViewer Style="{StaticResource SidebarScrollViewer}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                <StackPanel Margin="8,12">

                    <!-- ── CLINICAL ──────────────────────────────────────────── -->
                    <TextBlock Text="CLINICAL"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="#4A6FA5" Margin="10,0,0,6"
                               TextTrimming="CharacterEllipsis"/>

                    <Button x:Name="NavDashboardBtn"
                            Style="{StaticResource NavButton}"
                            Click="NavDashboard_Click"
                            ToolTip="Clinic overview and quick actions">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="22" Height="16" Stretch="Uniform"
                                     VerticalAlignment="Center" Margin="0,0,10,0">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="{StaticResource Ico.Home}"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Nav.Dashboard}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Button>

                    <Button x:Name="NavPatientsBtn"
                            Visibility="Collapsed"
                            Style="{StaticResource NavButton}"
                            Click="NavPatients_Click"
                            ToolTip="View and manage patient visits">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="22" Height="16" Stretch="Uniform"
                                     VerticalAlignment="Center" Margin="0,0,10,0">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="{StaticResource Ico.Person}"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Nav.Patients}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Button>

                    <!-- Physicians — visible when ManagePhysicians or Admin -->
                    <Button x:Name="NavPhysiciansBtn"
                            Visibility="Collapsed"
                            Style="{StaticResource NavButton}"
                            Click="NavPhysicians_Click"
                            ToolTip="Manage physician profiles">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="22" Height="16" Stretch="Uniform"
                                     VerticalAlignment="Center" Margin="0,0,10,0">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="{StaticResource Ico.Person}"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Nav.Physicians}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Button>

                    <!-- Medicines — visible when ManageMedicineCatalog or Admin -->
                    <Button x:Name="NavMedicinesBtn"
                            Visibility="Collapsed"
                            Style="{StaticResource NavButton}"
                            Click="NavMedicines_Click"
                            ToolTip="Manage the medicine catalog">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="22" Height="16" Stretch="Uniform"
                                     VerticalAlignment="Center" Margin="0,0,10,0">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="{StaticResource Ico.Pill}"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Nav.Medicines}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Button>

                    <!-- Options — visible when ManageMedicineCatalog or Admin -->
                    <Button x:Name="NavOptionsBtn"
                            Visibility="Collapsed"
                            Style="{StaticResource NavButton}"
                            Click="NavOptions_Click"
                            ToolTip="Manage medicine categories, forms and notes">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="22" Height="16" Stretch="Uniform"
                                     VerticalAlignment="Center" Margin="0,0,10,0">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="{StaticResource Ico.Settings}"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Nav.Options}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Button>

                    <!-- ── ADMINISTRATION — visible only to Admin / ManageUsers ── -->
                    <StackPanel x:Name="AdminNav" Visibility="Collapsed">
                        <Border Height="1" Background="#2E4A6A" Margin="4,10,4,8"/>
                        <TextBlock Text="ADMINISTRATION"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="#4A6FA5" Margin="10,0,0,6"
                                   TextTrimming="CharacterEllipsis"/>

                        <Button Style="{StaticResource NavButton}"
                                Click="NavUsers_Click"
                                ToolTip="Manage user accounts and roles">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="22" Height="16" Stretch="Uniform"
                                         VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="{StaticResource Ico.Group}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Nav.Users}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource NavButton}"
                                Click="NavCustomRoles_Click"
                                ToolTip="Define custom role permissions for non-standard staff">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="22" Height="16" Stretch="Uniform"
                                         VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="{StaticResource Ico.Shield}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Custom Roles"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Button>

                        <Button x:Name="NavImportBtn"
                                Style="{StaticResource NavButton}"
                                Click="NavImport_Click"
                                ToolTip="Import data from Access database">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="22" Height="16" Stretch="Uniform"
                                         VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="{StaticResource Ico.Download}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Nav.Import}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Button>

                        <Button x:Name="NavBackupBtn"
                                Style="{StaticResource NavButton}"
                                Click="NavBackup_Click"
                                ToolTip="Backup and restore the clinic database">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="22" Height="16" Stretch="Uniform"
                                         VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="{StaticResource Ico.Archive}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Nav.Backup}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource NavButton}"
                                Click="NavSettings_Click"
                                ToolTip="Customise report design and print settings">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="22" Height="16" Stretch="Uniform"
                                         VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="{StaticResource Ico.Printer}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Print Settings"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Button>

                    </StackPanel>
                </StackPanel>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <!-- ═══ CONTENT AREA ═══ -->
        <ContentControl x:Name="ContentArea" Grid.Column="1"
                        Background="{StaticResource ContentBgBrush}"/>

        <!-- ═══ SESSION LOCK OVERLAY ═══ -->
        <Grid x:Name="LockOverlay"
              Grid.Column="0" Grid.ColumnSpan="2"
              Panel.ZIndex="100"
              Visibility="Collapsed"
              FlowDirection="LeftToRight"
              Background="#CC1A1A2E">
            <Border Style="{StaticResource Card}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="360" Padding="40,36">
                <StackPanel>
                    <Viewbox Width="48" Height="48" Stretch="Uniform"
                             HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Canvas Width="24" Height="24">
                            <Path Fill="{StaticResource PrimaryBrush}" Data="{StaticResource Ico.Lock}"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Session Locked" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="LockUserText" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,24"/>
                    <TextBlock Text="Enter your password to continue:"
                               FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,8"/>
                    <PasswordBox x:Name="LockPasswordBox"
                                 Height="36" FontSize="13" Padding="8,0"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 BorderThickness="1"
                                 KeyDown="LockPasswordBox_KeyDown"/>
                    <TextBlock x:Name="LockErrorText"
                               Text="Incorrect password — please try again."
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="11" Margin="0,6,0,0"
                               Visibility="Collapsed"/>
                    <Button Content="Unlock" Style="{StaticResource PrimaryButton}"
                            Margin="0,16,0,0" Click="Unlock_Click"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
